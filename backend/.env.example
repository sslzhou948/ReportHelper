DATABASE_URL="postgresql://healthhelper:healthhelper@localhost:5432/healthhelper?schema=public"
JWT_SECRET="replace-with-local-dev-secret"
WECHAT_APP_ID="wx382d538fd178a873"
WECHAT_APP_SECRET="put-secret-in-local-env-only"
NODE_ENV="development"
PORT="8787"
UPLOAD_STORAGE_PROVIDER="local"
ALLOW_LOCAL_UPLOAD_STORAGE_IN_PRODUCTION="false"
LOCAL_OBJECT_STORAGE_DIR="../local-object-storage"
