{
  "name": "healthhelper-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:memory": "tsx src/testing/memory-server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsx src/services/image-quality.test.ts && tsx src/services/raw-ocr-parser.test.ts && tsx src/domain/duplicate.test.ts && tsx src/domain/metric-category.test.ts && tsx src/domain/metric-key.test.ts && tsx src/backend-smoke.test.ts",
    "smoke:gpt-ocr": "tsx src/gpt-ocr-realcase-smoke.ts",
    "start": "node dist/server.js",
    "migration:check": "node scripts/check-migration.js",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:reset": "prisma migrate reset --force",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.1.0",
    "@prisma/client": "^5.22.0",
    "fastify": "^5.8.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
