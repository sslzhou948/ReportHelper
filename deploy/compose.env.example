# Copy this file to .env beside docker-compose.yml on your Linux host.
# Never commit the copied .env with real secrets.

BACKEND_IMAGE_TAG=latest
BACKEND_CONTAINER_NAME=healthhelper-backend
BACKEND_BIND_HOST=0.0.0.0
BACKEND_HOST_PORT=8787

POSTGRES_CONTAINER_NAME=healthhelper-postgres
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_HOST_PORT=5432
POSTGRES_USER=healthhelper
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=healthhelper

POSTGRES_DATA_DIR=./data/postgres
UPLOAD_DATA_DIR=./data/uploads

JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
WECHAT_APP_ID=wx382d538fd178a873
WECHAT_APP_SECRET=change-this-wechat-app-secret
BACKEND_PUBLIC_BASE_URL=https://api.your-domain.com

OCR_PROVIDER=gpt_vision
OPENAI_API_BASE_URL=https://api.ads8260.win:8260/v1
OPENAI_OCR_MODEL=gpt-5.4-mini
OPENAI_API_KEY=change-this-llm-api-key
OCR_MAX_RETRIES=1
OCR_RETRY_BASE_MS=250
OCR_GROUP_CONCURRENCY=2
OCR_REQUEST_TIMEOUT_MS=240000
OCR_MAX_OUTPUT_TOKENS=6000

RUN_PRISMA_MIGRATIONS=true
