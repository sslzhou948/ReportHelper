<view class="page">
  <view class="nav">
    <view class="nav-side left" bindtap="goBack">‹ 返回</view>
    <view class="nav-title">复查详情</view>
    <view class="nav-side right"></view>
  </view>
  <view class="section-title">基本信息</view>
  <view class="pad">
    <view class="card">
      <view class="row" data-key="type" data-label="检查类型" bindtap="editField"><view class="sub label">检查类型</view><view class="flex right">{{plan.type}}</view><view class="arrow">›</view></view>
      <view class="row" data-key="date" data-label="日期" bindtap="editField"><view class="sub label">日期</view><view class="flex right">{{plan.date}}</view><view class="arrow">›</view></view>
      <view class="row" data-key="hospital" data-label="医院" bindtap="editField"><view class="sub label">医院</view><view class="flex right">{{plan.hospital}}</view><view class="arrow">›</view></view>
      <view class="row" data-key="department" data-label="科室" bindtap="editField"><view class="sub label">科室</view><view class="flex right">{{plan.department || '未指定'}}</view><view class="arrow">›</view></view>
    </view>
  </view>
  <view class="countdown"><hh-pill tone="primary">{{days}} 天后</hh-pill></view>
  <view class="section-title">待办事项</view>
  <view class="pad">
    <view class="card">
      <view wx:for="{{plan.todos}}" wx:key="id" class="row">
        <view class="todo-box {{item.isDone ? 'done' : ''}}">{{item.isDone ? '✓' : ''}}</view>
        <view class="flex">{{item.text}}</view>
      </view>
      <view class="row add-row" bindtap="addTodo">+ 添加待办</view>
    </view>
  </view>
  <view class="section-title">提醒</view>
  <view class="pad">
    <view class="card">
      <view class="row"><view class="flex">提前 3 天</view><switch checked color="#5A7A5A" /></view>
      <view class="row"><view class="flex">提前 1 天</view><switch checked color="#5A7A5A" /></view>
      <view class="row"><view class="flex">当天上午</view><switch color="#5A7A5A" /></view>
    </view>
  </view>
  <view class="pad danger-zone">
    <view class="btn secondary" bindtap="cancelPlan">取消此次复查</view>
    <view class="btn secondary danger-text" bindtap="deletePlan">删除此计划</view>
  </view>
</view>
