.check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  border: 3rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
}

.check.on {
  background: var(--primary);
  border-color: var(--primary);
}

.row.saving {
  opacity: 0.62;
}

.strong {
  font-weight: 700;
}
