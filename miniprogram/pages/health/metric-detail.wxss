.pin-action {
  flex: 0 0 auto;
  min-width: 128rpx;
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 28rpx;
  background: var(--primary-soft);
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.pin-action.active {
  background: var(--primary);
  color: #FFFFFF;
}

.pin-action.saving {
  opacity: 0.62;
}

.pin-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.38);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 900;
}

.metric-big {
  font-size: 84rpx;
  font-weight: 900;
  line-height: 1;
}

.metric-big.low,
.history-value.low {
  color: var(--low);
}

.metric-big.high,
.metric-big.positive,
.history-value.high,
.history-value.positive {
  color: var(--high);
}

.metric-unit {
  margin-left: 8rpx;
  font-size: 24rpx;
  color: var(--ink-3);
  font-weight: 500;
}

.pill-row {
  margin-top: 24rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.notice {
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: var(--warn-soft);
  color: var(--warn);
  font-size: 24rpx;
}

.report-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.range-row {
  margin-bottom: 18rpx;
  display: flex;
  gap: 12rpx;
}

.range-chip {
  height: 50rpx;
  padding: 0 20rpx;
  border-radius: 25rpx;
  background: #F5F2EC;
  color: var(--ink-2);
  font-size: 22rpx;
  display: flex;
  align-items: center;
}

.range-chip.active {
  background: var(--primary);
  color: #FFFFFF;
  font-weight: 700;
}

.strong {
  font-weight: 700;
}

.history-value {
  font-size: 32rpx;
  font-weight: 800;
}

.arrow {
  color: var(--ink-3);
  font-size: 40rpx;
}
