.page {
  background: #F7F5F2;
}

.nav {
  background: #FFFFFF;
  border-bottom: 0;
}

.pad {
  padding: 0 22rpx;
}

.pad > .card {
  border-radius: 22rpx;
  border-color: #E7E1D9;
  box-shadow: 0 8rpx 24rpx rgba(42, 39, 34, 0.055);
}

.card-pad {
  padding: 28rpx 30rpx;
}

.pin-action {
  flex: 0 0 auto;
  min-width: 128rpx;
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 22rpx;
  background: #EAF0E7;
  color: #527858;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.pin-action.active {
  background: #527858;
  color: #FFFFFF;
}

.pin-action.saving {
  opacity: 0.62;
}

.pin-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.38);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 900;
}

.metric-big {
  font-size: 74rpx;
  font-weight: 700;
  line-height: 1;
}

.metric-big.low,
.history-value.low {
  color: var(--low);
}

.metric-big.high,
.metric-big.positive,
.history-value.high,
.history-value.positive {
  color: var(--high);
}

.metric-unit {
  margin-left: 8rpx;
  font-size: 28rpx;
  color: var(--ink-3);
  font-weight: 400;
}

.pill-row {
  margin-top: 18rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.notice {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: var(--warn-soft);
  color: var(--warn);
  font-size: 24rpx;
}

.report-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.range-row {
  margin-bottom: 18rpx;
  display: flex;
  gap: 16rpx;
}

.range-chip {
  min-width: 114rpx;
  height: 52rpx;
  padding: 0 26rpx;
  border-radius: 26rpx;
  background: #FFFFFF;
  border: 1rpx solid #ECE7DF;
  color: #4F4841;
  font-size: 25rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.range-chip.active {
  min-width: 96rpx;
  background: linear-gradient(145deg, #6D946D 0%, #527858 100%);
  border-color: #527858;
  color: #FFFFFF;
  font-weight: 800;
  box-shadow: 0 5rpx 12rpx rgba(50, 76, 51, 0.14);
}

.strong {
  font-weight: 700;
}

.history-value {
  font-size: 28rpx;
  font-weight: 700;
}

.arrow {
  color: var(--ink-3);
  font-size: 40rpx;
}

.row {
  min-height: 96rpx;
  padding: 24rpx 28rpx;
  border-bottom-color: #E7E1D9;
}
