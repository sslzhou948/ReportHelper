.search-ref-page {
  background: #F7F5F2;
  color: #24211D;
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}

.search-nav {
  background: #F7F5F2;
  border-bottom: 0;
  box-shadow: none;
}

.search-nav .nav-title {
  color: #1F1F1F;
  font-size: 36rpx;
  font-weight: 700;
}

.search-nav .nav-side {
  color: #24211D;
  font-size: 30rpx;
  font-weight: 400;
}

.search-pad {
  margin-top: 18rpx;
}

.search-box {
  height: 96rpx;
  padding: 0 24rpx;
  border-radius: 30rpx;
  border: 3rpx solid #668865;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-shadow: 0 6rpx 18rpx rgba(42, 39, 34, 0.04);
}

.search-icon {
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
  opacity: 0.72;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  line-height: 88rpx;
  color: #24211D;
  font-size: 31rpx;
  font-weight: 400;
}

.search-input::placeholder {
  color: #A49C92;
}

.search-clear {
  flex: 0 0 auto;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #A7A39C;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  line-height: 1;
}

.search-section-title {
  margin: 42rpx 0 18rpx;
  color: #24211D;
  font-size: 31rpx;
  font-weight: 700;
}

.search-result-card {
  border-radius: 24rpx;
  border: 1rpx solid #E7E1D9;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(42, 39, 34, 0.045);
}

.search-result-row {
  min-height: 120rpx;
  padding: 22rpx 26rpx;
  gap: 24rpx;
  border-bottom: 1rpx solid #E7E1D9;
  background: #FFFFFF;
}

.search-result-row:last-child {
  border-bottom: 0;
}

.report-row {
  min-height: 136rpx;
}

.result-icon {
  flex: 0 0 auto;
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
}

.report-icon {
  width: 70rpx;
  height: 70rpx;
}

.result-main {
  flex: 1;
  min-width: 0;
}

.result-title {
  color: #24211D;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.22;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-sub,
.result-date {
  margin-top: 9rpx;
  color: #6E675F;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.18;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-date {
  color: #8A827A;
}

.search-badge {
  flex: 0 0 auto;
  min-width: 78rpx;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 600;
  white-space: nowrap;
}

.search-badge.high {
  background: #FBE1DC;
  color: #C55243;
}

.search-arrow {
  flex: 0 0 auto;
  color: #817A72;
  font-size: 48rpx;
  line-height: 1;
}

.search-empty-row {
  min-height: 96rpx;
  padding: 28rpx;
  color: #8B8580;
  font-size: 26rpx;
  line-height: 1.35;
}

.search-helper {
  width: 456rpx;
  min-height: 112rpx;
  margin: 38rpx auto 0;
  padding: 22rpx 30rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #5F5953;
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-size: 27rpx;
  line-height: 1.35;
  box-shadow: 0 8rpx 28rpx rgba(42, 39, 34, 0.04);
}

.helper-icon {
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #E7EEE5;
}
