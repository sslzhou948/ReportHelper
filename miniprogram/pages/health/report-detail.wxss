.page {
  background: #F7F5F2;
  padding-bottom: calc(168rpx + env(safe-area-inset-bottom));
}

.nav {
  background: #FFFFFF;
  border-bottom: 0;
}

.report-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.pad {
  padding: 0 22rpx;
}

.pad > .card {
  border-radius: 22rpx;
  border-color: #E7E1D9;
  box-shadow: 0 8rpx 24rpx rgba(42, 39, 34, 0.055);
}

.card-pad {
  padding: 28rpx 30rpx;
}

.nav-title {
  font-weight: 600;
}

.strong {
  font-weight: 700;
}

.report-tags {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  height: 38rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  background: #EAF0E7;
  color: #527858;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  font-weight: 500;
}

.tag.muted {
  background: #F1EEE8;
  color: var(--ink-2);
}

.metric-row.low {
  background: #FFFFFF;
}

.metric-row.high,
.metric-row.positive {
  background: #FFFFFF;
}

.metric-row {
  min-height: 112rpx;
  padding: 22rpx 30rpx;
  border-bottom-color: #E7E1D9;
}

.metric-value {
  font-size: 30rpx;
  font-weight: 700;
}

.metric-name-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.report-marker-badge {
  flex: 0 0 auto;
  width: 24rpx;
  height: 32rpx;
  color: #17130F;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 32rpx;
  text-align: center;
  transform: translateY(1rpx);
}

.text-metric-row {
  align-items: flex-start;
}

.text-metric-value {
  max-width: 360rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.5;
  text-align: right;
}

.metric-value.low {
  color: var(--low);
}

.metric-value.high,
.metric-value.positive {
  color: var(--high);
}

.trend-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  background: #EAF0E7;
  color: #527858;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
}

.finding-row {
  display: grid;
  grid-template-columns: 16rpx 1fr;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-soft);
}

.finding-row:last-child {
  border-bottom: 0;
}

.finding-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: var(--primary);
  margin-top: 12rpx;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 22rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #E7E1D9;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.bottom-actions .btn {
  height: 72rpx;
  border-radius: 14rpx;
  font-size: 30rpx;
}

.bottom-actions .btn.secondary {
  background: #FFFFFF;
  border-color: #527858;
  color: #527858;
}

.bottom-actions .btn.danger {
  background: #FFFFFF;
  border: 2rpx solid #D84D43;
  color: #D84D43;
}
