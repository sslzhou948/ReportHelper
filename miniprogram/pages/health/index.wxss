.health-ref-page {
  background: #F7F5F2;
}

.health-hero {
  position: relative;
  height: 318rpx;
  min-height: 318rpx;
  padding: calc(var(--safe-top) - 98rpx) 27rpx 0;
  overflow: hidden;
  color: #FFFFFF;
  background:
    radial-gradient(circle at 38% -20%, rgba(255, 255, 255, 0.15), transparent 38%),
    linear-gradient(145deg, #739672 0%, #638965 48%, #527858 100%);
  border-bottom-left-radius: 50rpx;
  border-bottom-right-radius: 50rpx;
  box-shadow: 0 10rpx 24rpx rgba(59, 82, 59, 0.14);
  box-sizing: border-box;
}

.health-nav {
  position: relative;
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.health-title {
  color: #F7FAF7;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.2;
  text-align: center;
  text-shadow: 0 2rpx 8rpx rgba(32, 62, 38, 0.12);
}

.health-search {
  height: 78rpx;
  margin-top: 33rpx;
  padding: 0 26rpx;
  border-radius: 13rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  display: flex;
  align-items: center;
  gap: 17rpx;
  box-shadow: 0 5rpx 12rpx rgba(39, 49, 38, 0.12);
}

.search-icon {
  flex: 0 0 auto;
  width: 39rpx;
  height: 39rpx;
}

.search-text {
  color: #9B928A;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1;
}

.health-controls {
  padding: 24rpx 23rpx 0;
}

.health-segmented {
  width: 100%;
  height: 85rpx;
  padding: 0;
  border-radius: 13rpx;
  background: rgba(235, 231, 225, 0.75);
  display: grid;
  grid-template-columns: 1fr 1fr;
  overflow: hidden;
  box-shadow: inset 0 0 0 1rpx rgba(229, 224, 216, 0.72);
}

.health-segment {
  min-width: 0;
  height: 85rpx;
  border-radius: 12rpx;
  color: #2E2924;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.health-segment.active.metric-segment {
  background: #FFFFFF;
  color: #527858;
  box-shadow: 0 8rpx 18rpx rgba(42, 39, 34, 0.06);
}

.health-segment.active.time-segment {
  background: linear-gradient(145deg, #6D946D 0%, #527858 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 18rpx rgba(50, 76, 51, 0.14);
}

.segment-label {
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.15;
}

.segment-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.1;
  color: #5E7F61;
}

.time-segment.active .segment-sub {
  color: rgba(255, 255, 255, 0.92);
}

.metric-segment:not(.active) .segment-sub,
.time-segment:not(.active) .segment-sub {
  color: #6F675F;
}

.health-range-row {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  gap: 17rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.health-range-chip {
  flex: 0 0 auto;
  min-width: 114rpx;
  height: 52rpx;
  padding: 0 26rpx;
  border-radius: 26rpx;
  background: #FFFFFF;
  border: 1rpx solid #ECE7DF;
  color: #4F4841;
  font-size: 25rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 7rpx rgba(42, 39, 34, 0.035);
}

.health-range-chip.active {
  min-width: 96rpx;
  background: linear-gradient(145deg, #6D946D 0%, #527858 100%);
  border-color: #527858;
  color: #FFFFFF;
  font-weight: 800;
  box-shadow: 0 5rpx 12rpx rgba(50, 76, 51, 0.14);
}

.health-scope-hint {
  color: #68615A;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 34rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.health-scope-hint-below {
  margin-top: 10rpx;
  padding: 0 23rpx;
}

.health-chips {
  width: 100%;
  white-space: nowrap;
  padding: 14rpx 0 10rpx 23rpx;
  box-sizing: border-box;
  overflow-x: hidden;
}

.health-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  height: 52rpx;
  margin-right: 15rpx;
  padding: 0 26rpx;
  border-radius: 26rpx;
  border: 1rpx solid #E7E0D8;
  background: #FFFFFF;
  color: #4F4841;
  font-size: 24rpx;
  font-weight: 600;
  vertical-align: top;
  box-shadow: 0 2rpx 7rpx rgba(42, 39, 34, 0.035);
}

.health-chip.active {
  background: linear-gradient(145deg, #6D946D 0%, #527858 100%);
  border-color: #527858;
  color: #FFFFFF;
  font-weight: 800;
}

.chip-badge {
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 7rpx;
  border-radius: 14rpx;
  background: #D84D43;
  color: #FFFFFF;
  font-size: 19rpx;
  font-weight: 800;
  line-height: 28rpx;
  text-align: center;
}

.health-pad {
  padding: 0 22rpx;
}

.metric-group-wrap {
  margin-top: 16rpx;
}

.metric-group-card,
.report-month-card,
.health-empty-card {
  width: 100%;
  max-width: none;
  margin: 0;
  border-radius: 18rpx;
  background: #FFFFFF;
  border: 1rpx solid #ECE7DF;
  box-shadow: 0 8rpx 26rpx rgba(42, 39, 34, 0.055);
  overflow: hidden;
}

.metric-group-head {
  min-height: 84rpx;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 13rpx;
}

.group-icon {
  flex: 0 0 auto;
  width: 52rpx;
  height: 52rpx;
}

.group-title {
  flex: 0 1 auto;
  min-width: 74rpx;
  max-width: 184rpx;
  color: #282521;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.group-count,
.group-abnormal,
.group-normal {
  flex: 0 0 auto;
  min-height: 35rpx;
  padding: 5rpx 15rpx;
  border-radius: 18rpx;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.1;
  white-space: nowrap;
}

.group-count {
  background: #F2F0ED;
  color: #68615A;
}

.group-abnormal {
  background: #F8E7E4;
  color: #D84D43;
}

.group-normal {
  background: #E7EEE5;
  color: #527858;
}

.group-spacer {
  flex: 1;
  min-width: 4rpx;
}

.group-date {
  flex: 0 0 auto;
  min-width: 142rpx;
  color: #8A827A;
  font-size: 24rpx;
  line-height: 1.2;
  text-align: right;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.metric-data-row {
  min-height: 72rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  border-top: 1rpx solid #E7E1D9;
  background: #FFFFFF;
}

.metric-warning {
  flex: 0 0 auto;
  width: 27rpx;
  height: 27rpx;
  margin-right: 8rpx;
}

.metric-name {
  flex: 1;
  min-width: 0;
  color: #342F2A;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.metric-name.with-warning {
  flex-basis: calc(100% - 33rpx);
}

.metric-value {
  flex: 0 0 112rpx;
  color: #24211D;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
  text-align: right;
}

.metric-value.high,
.metric-value.positive,
.metric-value.abnormal {
  color: #D84D43;
}

.metric-value.low {
  color: #2F6DB3;
}

.metric-unit {
  flex: 0 0 98rpx;
  padding-left: 24rpx;
  color: #8A827A;
  font-size: 22rpx;
  line-height: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.metric-dot {
  flex: 0 0 auto;
  width: 14rpx;
  height: 14rpx;
  margin-left: 6rpx;
  border-radius: 50%;
  background: #638565;
}

.metric-trend-up {
  flex: 0 0 24rpx;
  margin-left: 2rpx;
  color: #D84D43;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1;
  text-align: center;
}

.metric-chevron {
  flex: 0 0 28rpx;
  color: #8A827A;
  font-size: 34rpx;
  line-height: 1;
  text-align: right;
}

.report-month-section {
  margin-top: 27rpx;
}

.report-month-head {
  min-height: 47rpx;
  padding: 0 31rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.report-month-title {
  color: #24211D;
  font-size: 33rpx;
  font-weight: 800;
  line-height: 1.2;
}

.report-month-count {
  color: #4F4841;
  font-size: 25rpx;
  line-height: 1;
}

.report-month-card {
  margin-top: 14rpx;
}

.report-data-row {
  min-height: 120rpx;
  padding: 20rpx 22rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-bottom: 1rpx solid #E7E1D9;
}

.report-data-row:last-child {
  border-bottom: 0;
}

.report-date-block {
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: #F0EEEB;
  color: #2D2925;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.report-day {
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
}

.report-month {
  margin-top: 5rpx;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
}

.report-main {
  flex: 1;
  min-width: 0;
}

.report-title {
  color: #27241F;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.report-hospital {
  margin-top: 7rpx;
  color: #847B73;
  font-size: 23rpx;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.report-status {
  flex: 0 0 auto;
  min-height: 37rpx;
  padding: 6rpx 17rpx;
  border-radius: 18rpx;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.08;
  white-space: nowrap;
}

.report-status.high {
  background: #F8E7E4;
  color: #D84D43;
}

.report-status.primary {
  background: #E7EEE5;
  color: #527858;
}

.report-chevron {
  flex: 0 0 auto;
  color: #6C655D;
  font-size: 40rpx;
  line-height: 1;
}

.empty-wrap {
  margin-top: 32rpx;
}

.health-empty-card {
  padding: 32rpx 28rpx;
}

.empty-title {
  color: #282521;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.2;
}

.empty-sub {
  margin-top: 10rpx;
  color: #8A827A;
  font-size: 24rpx;
  line-height: 1.4;
}
