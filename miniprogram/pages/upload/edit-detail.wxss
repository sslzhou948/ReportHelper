.edit-page {
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

.notice {
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: var(--warn-soft);
  color: var(--warn);
  font-size: 24rpx;
}

.source-preview-pad {
  margin-top: 0;
}

.source-preview-strip {
  white-space: nowrap;
  width: 100%;
}

.source-preview-thumb {
  position: relative;
  display: inline-block;
  width: 152rpx;
  height: 88rpx;
  margin-right: 14rpx;
  border-radius: 10rpx;
  overflow: hidden;
  background: #F0ECE6;
  border: 1rpx solid #DDD6CC;
  box-shadow: 0 3rpx 10rpx rgba(42, 39, 34, 0.035);
}

.source-preview-image {
  width: 100%;
  height: 100%;
  display: block;
}

.label {
  min-width: 146rpx;
  color: #3C3630;
  font-size: 26rpx;
}

.edit-row {
  min-height: 88rpx;
  padding: 14rpx 24rpx;
  border-bottom: 1rpx solid #E7E1D9;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.edit-row:last-child {
  border-bottom: 0;
}

.edit-input {
  flex: 1;
  min-width: 0;
  height: 58rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  border: 1rpx solid #E7E1D9;
  background: #FFFFFF;
  text-align: right;
  color: #24211D;
  font-size: 26rpx;
}

.date-picker {
  flex: 1;
  min-width: 0;
  display: flex;
  justify-content: flex-end;
}

.edit-picker {
  min-width: 244rpx;
  height: 58rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  border: 1rpx solid #E7E1D9;
  background: #FFFFFF;
  color: #24211D;
  font-size: 26rpx;
  text-align: right;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.edit-picker.placeholder {
  color: var(--ink-3);
}

.readonly {
  color: #5F5953;
  font-size: 26rpx;
}

.source-note {
  margin-top: 16rpx;
  color: var(--warn);
  font-size: 24rpx;
}

.manual-actions {
  margin-top: 18rpx;
  display: flex;
  gap: 18rpx;
}

.manual-actions .btn {
  flex: 1;
  height: 72rpx;
  border-radius: 12rpx;
  border-color: #527858;
  color: #527858;
  font-size: 27rpx;
  font-weight: 600;
  box-shadow: none;
}

.manual-actions.in-empty {
  margin-top: 24rpx;
}

.warn-dot {
  width: 30rpx;
  height: 30rpx;
  border-radius: 15rpx;
  background: #E4A93E;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 19rpx;
  font-weight: 800;
}

.warning-row,
.finding-row {
  display: grid;
  grid-template-columns: 34rpx 1fr;
  min-height: 84rpx;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--border-soft);
  align-items: center;
}

.metric-edit {
  padding: 24rpx 24rpx;
  border-bottom: 1rpx solid var(--border-soft);
}

.metric-edit:last-child {
  border-bottom: 0;
}

.metric-name {
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.metric-title-left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.report-marker-badge {
  flex: 0 0 auto;
  width: 24rpx;
  height: 32rpx;
  color: #17130F;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 32rpx;
  text-align: center;
  transform: translateY(1rpx);
}

.metric-name-input {
  flex: 1;
  min-width: 0;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 14rpx;
  background: #F7F4EE;
  padding: 0 16rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
}

.status-pill {
  flex: 0 0 auto;
  min-width: 86rpx;
  height: 34rpx;
  padding: 0 12rpx;
  border-radius: 10rpx;
  background: #F5F1EA;
  color: #A96724;
  font-size: 21rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.metric-actions {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.delete-x {
  width: 38rpx;
  height: 38rpx;
  border-radius: 19rpx;
  background: #F5F1EA;
  color: #8A827A;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  line-height: 36rpx;
  font-weight: 700;
}

.metric-read {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 10rpx 16rpx;
  align-items: center;
}

.metric-value {
  font-size: 34rpx;
  font-weight: 800;
}

.metric-value.value-low,
.value-input.value-low {
  color: var(--low);
}

.metric-value.value-high,
.metric-value.value-positive,
.value-input.value-high {
  color: var(--high);
}

.unit-chip {
  min-width: 96rpx;
  height: 44rpx;
  padding: 0 14rpx;
  border-radius: 22rpx;
  background: #F1EEE8;
  color: var(--ink-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
}

.ref-read {
  grid-column: 1 / -1;
}

.metric-inputs,
.qualitative-edit {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 132rpx;
  gap: 14rpx;
  align-items: center;
}

.text-metric-edit {
  margin-top: 8rpx;
}

.text-metric-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 144rpx;
  border-radius: 18rpx;
  background: #F7F4EE;
  padding: 18rpx;
  color: var(--ink-1);
  font-size: 26rpx;
  line-height: 1.5;
}

.ref-editor {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 10rpx;
}

.ref-mode-row {
  width: 100%;
  display: grid;
  grid-template-columns: 92rpx 156rpx;
  justify-content: flex-start;
  gap: 10rpx;
  align-items: center;
}

.ref-mode-row .tiny {
  color: #6E675F;
  line-height: 62rpx;
  white-space: nowrap;
}

.ref-inputs {
  width: 100%;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 24rpx minmax(0, 1fr);
  gap: 10rpx;
  align-items: center;
}

.ref-single-input,
.ref-text-edit {
  flex: 1;
  width: 100%;
}

.ref-text-note {
  margin-top: 14rpx;
  display: grid;
  grid-template-columns: 72rpx 1fr;
  gap: 10rpx;
  align-items: start;
}

.ref-text {
  color: var(--ink-2);
  line-height: 1.45;
}

.range-separator {
  color: var(--ink-3);
  text-align: center;
  font-weight: 700;
}

.mini-input {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  height: 62rpx;
  line-height: 62rpx;
  border-radius: 12rpx;
  border: 1rpx solid #E7E1D9;
  background: #FFFFFF;
  padding: 0 16rpx;
  color: #24211D;
  font-size: 26rpx;
}

.picker-mini {
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  overflow: hidden;
}

.ref-textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 116rpx;
  border-radius: 14rpx;
  background: #F7F4EE;
  padding: 16rpx;
  color: var(--ink-1);
  font-size: 26rpx;
  line-height: 1.45;
}

.value-input {
  max-width: none;
}

.unit-readonly {
  min-width: 104rpx;
  max-width: 176rpx;
  min-height: 52rpx;
  padding: 0 14rpx;
  border-radius: 26rpx;
  background: #F1EEE8;
  color: var(--ink-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  text-align: center;
}

.unit-input {
  width: 132rpx;
  text-align: center;
}

.card-last-spacer {
  height: calc(260rpx + env(safe-area-inset-bottom));
}

.editable-finding {
  position: relative;
  grid-template-columns: 16rpx 1fr;
  padding-right: 56rpx;
}

.finding-delete {
  position: absolute;
  top: 14rpx;
  right: 0;
}

.finding-input {
  width: 100%;
  min-height: 112rpx;
  color: var(--ink-1);
  font-size: 28rpx;
  line-height: 1.55;
}

.warning-row:last-child,
.finding-row:last-child {
  border-bottom: 0;
}

.finding-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: var(--primary);
  margin: 14rpx 0 0 10rpx;
}

.strong {
  font-weight: 700;
}

.empty-detail {
  padding: 32rpx 24rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  color: var(--ink-2);
}

.add-row {
  justify-content: center;
  color: var(--primary);
}

.bottom-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  padding: 22rpx 32rpx calc(22rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(247, 245, 242, 0) 0%, #F7F5F2 26%);
  border-top: 0;
  box-shadow: none;
}

.bottom-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.btn.disabled {
  opacity: 0.58;
}

.upload-ref-page {
  background: #F7F5F2;
  color: #24211D;
}

.upload-nav {
  position: relative;
  top: auto;
  min-height: 186rpx;
  padding: 122rpx 32rpx 20rpx;
  background: #F7F5F2;
  border-bottom: 0;
  box-shadow: none;
}

.upload-nav .nav-title {
  color: #1F1F1F;
  font-size: 36rpx;
  font-weight: 700;
}

.upload-nav .nav-side {
  color: #24211D;
  font-size: 30rpx;
  font-weight: 400;
}

.upload-nav .nav-side.right {
  color: #527858;
}

.edit-top {
  margin-top: 6rpx;
}

.detail-notice {
  width: 100%;
  min-height: 64rpx;
  padding: 16rpx 22rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 25rpx;
  line-height: 1.35;
}

.detail-notice.warn {
  background: #FFF5E7;
  color: #A96724;
}

.detail-notice-icon {
  flex: 0 0 auto;
  width: 34rpx;
  height: 34rpx;
}

.detail-notice-text {
  flex: 1;
  min-width: 0;
}

.edit-section-title {
  margin: 28rpx 0 14rpx;
  padding: 0 32rpx;
  color: #24211D;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
}

.source-preview-check {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  background: #527858;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(42, 39, 34, 0.16);
}

.source-preview-check-icon {
  width: 22rpx;
  height: 22rpx;
}

.edit-page .card {
  border-radius: 20rpx;
  border-color: #E7E1D9;
  box-shadow: 0 6rpx 20rpx rgba(42, 39, 34, 0.04);
}

.confirm-card {
  padding: 0 22rpx;
}

.metric-title-left .body {
  color: #24211D;
  font-size: 28rpx;
  line-height: 1.25;
}

.mini-input,
.metric-name-input,
.text-metric-input,
.ref-textarea {
  border: 1rpx solid #E7E1D9;
  background: #FFFFFF;
}

.bottom-action .btn {
  height: 88rpx;
  border-radius: 18rpx;
  background: linear-gradient(145deg, #638965 0%, #527858 100%);
  font-size: 31rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 18rpx rgba(50, 76, 51, 0.14);
}

.bottom-action .btn.secondary {
  background: #FFFFFF;
  border: 2rpx solid #527858;
  color: #527858;
  box-shadow: none;
}
