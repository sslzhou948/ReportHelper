.upload-page {
  padding-bottom: calc(192rpx + env(safe-area-inset-bottom));
}

.upload-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.upload-action {
  min-height: 220rpx;
  border-radius: 28rpx;
  border: 3rpx dashed var(--primary);
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-weight: 700;
}

.upload-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: var(--primary-soft);
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
}

.photo {
  height: 208rpx;
  border-radius: 24rpx;
  background: repeating-linear-gradient(135deg, #ECE8E1 0 12rpx, #F5F2EC 12rpx 24rpx);
  border: 2rpx solid var(--border);
  color: var(--ink-3);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.photo.grouped,
.photo.selected {
  border: 4rpx solid var(--primary);
}

.photo.add {
  background: #FFFFFF;
  border: 3rpx dashed var(--border);
  font-size: 48rpx;
}

.photo-thumb {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.photo-index {
  position: relative;
  z-index: 1;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.88);
  color: var(--ink-2);
  font-size: 24rpx;
  font-weight: 700;
}

.group-label,
.order-label {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  min-width: 44rpx;
  height: 44rpx;
  padding: 0 12rpx;
  border-radius: 22rpx;
  background: var(--primary);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 800;
  z-index: 2;
}

.order-label {
  left: auto;
  right: 10rpx;
}

.clip {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  color: var(--ink-2);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.split {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  min-width: 48rpx;
  height: 48rpx;
  padding: 0 12rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  color: var(--primary);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 800;
  z-index: 2;
}

.notice {
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 26rpx;
}

.draft-hint,
.upload-error {
  margin-top: 16rpx;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  line-height: 1.45;
}

.draft-hint {
  background: var(--primary-soft);
  color: var(--primary);
}

.upload-error {
  background: #FFF4E3;
  color: #A45B1E;
}

.center {
  text-align: center;
}

.group-actions {
  margin-top: 32rpx;
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 20rpx;
}

.empty-upload {
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  color: var(--ink-2);
}

.fixture-entry {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 2rpx solid var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.fixture-btn {
  flex: 0 0 112rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: var(--primary);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
}

.strong {
  font-weight: 700;
}

.btn.disabled,
.fixture-btn.disabled {
  opacity: 0.58;
}

.bottom-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid var(--border-soft);
}
