.upload-ref-page {
  background: #F7F5F2;
  color: #24211D;
}

.upload-page {
  padding-bottom: calc(192rpx + env(safe-area-inset-bottom));
}

.upload-nav {
  position: relative;
  top: auto;
  min-height: 186rpx;
  padding: 122rpx 32rpx 20rpx;
  background: #F7F5F2;
  border-bottom: 0;
  box-shadow: none;
}

.upload-nav .nav-title {
  color: #1F1F1F;
  font-size: 36rpx;
  font-weight: 700;
}

.upload-nav .nav-side {
  color: #24211D;
  font-size: 30rpx;
  font-weight: 400;
}

.upload-pad {
  padding: 0 32rpx;
}

.upload-top {
  margin-top: 6rpx;
}

.upload-action-wrap {
  margin-top: 20rpx;
}

.ocr-quality-tip {
  width: 100%;
  min-height: 124rpx;
  padding: 20rpx 28rpx 18rpx;
  border-radius: 24rpx;
  border: 1rpx solid #DDD6CD;
  background: #FFFFFF;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  box-shadow: 0 4rpx 12rpx rgba(42, 39, 34, 0.025);
}

.tip-icon {
  flex: 0 0 auto;
  width: 42rpx;
  height: 42rpx;
  margin-top: 2rpx;
}

.tip-title {
  color: #527858;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.2;
}

.tip-copy {
  margin-top: 9rpx;
  color: #5F5953;
  font-size: 28rpx;
  line-height: 1.48;
}

.upload-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 28rpx;
}

.upload-action {
  min-height: 102rpx;
  padding: 16rpx 24rpx;
  border-radius: 22rpx;
  border: 1rpx solid #DDD6CD;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  box-shadow: 0 4rpx 12rpx rgba(42, 39, 34, 0.025);
}

.upload-icon {
  flex: 0 0 auto;
  width: 58rpx;
  height: 58rpx;
}

.upload-action-title {
  color: #527858;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.2;
}

.upload-action-sub {
  margin-top: 7rpx;
  color: #6E675F;
  font-size: 25rpx;
  line-height: 1.15;
}

.upload-section-title {
  margin: 28rpx 0 18rpx;
  padding: 0 32rpx;
  color: #24211D;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.2;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
}

.photo {
  position: relative;
  height: 224rpx;
  border-radius: 20rpx;
  border: 1rpx solid #E2DCD3;
  background: #EEE9E2;
  color: #6F675F;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow: 0 5rpx 16rpx rgba(42, 39, 34, 0.035);
}

.photo.grouped,
.photo.selected {
  border: 4rpx solid #527858;
}

.photo.add {
  border: 3rpx dashed #D3CCC3;
  background: rgba(255, 255, 255, 0.56);
  box-shadow: none;
}

.photo-thumb {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.photo-index {
  position: absolute;
  left: 50%;
  bottom: 14rpx;
  transform: translateX(-50%);
  z-index: 2;
  width: 100rpx;
  height: 48rpx;
  padding: 0 10rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #24211D;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 48rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  box-shadow: 0 3rpx 10rpx rgba(42, 39, 34, 0.08);
}

.photo-delete,
.clip {
  position: absolute;
  right: 12rpx;
  z-index: 3;
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-delete {
  top: 12rpx;
  border-radius: 50%;
  border: 1rpx solid #E3DED6;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 3rpx 10rpx rgba(42, 39, 34, 0.10);
}

.photo-delete-icon {
  width: 34rpx;
  height: 34rpx;
  display: block;
}

.clip {
  bottom: 12rpx;
  border-radius: 50%;
  border: 1rpx solid #E3DED6;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 3rpx 10rpx rgba(42, 39, 34, 0.10);
  display: flex;
  align-items: center;
  justify-content: center;
}

.clip-icon {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

.add-photo-icon {
  width: 58rpx;
  height: 58rpx;
}

.group-label,
.order-label {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  z-index: 3;
  min-width: 48rpx;
  height: 48rpx;
  padding: 0 14rpx;
  border-radius: 24rpx;
  background: #527858;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
}

.order-label {
  left: auto;
  right: 12rpx;
}

.split {
  position: absolute;
  right: 12rpx;
  top: 72rpx;
  z-index: 3;
  min-width: 54rpx;
  height: 54rpx;
  padding: 0 12rpx;
  border-radius: 27rpx;
  background: #FFFFFF;
  color: #527858;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 600;
  box-shadow: 0 3rpx 10rpx rgba(42, 39, 34, 0.10);
}

.split-icon {
  width: 34rpx;
  height: 34rpx;
  display: block;
}

.quality-badge {
  position: absolute;
  left: 14rpx;
  bottom: 10rpx;
  z-index: 4;
  width: 42rpx;
  height: 42rpx;
  border-radius: 21rpx;
  background: #C0782D;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}

.upload-helper-wrap {
  margin-top: 32rpx;
}

.merge-helper {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  color: #5F5953;
}

.merge-helper-icon {
  flex: 0 0 auto;
  width: 34rpx;
  height: 34rpx;
}

.merge-helper-text {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  line-height: 1.45;
}

.empty-upload,
.fixture-entry {
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #E2DCD3;
  box-shadow: 0 6rpx 20rpx rgba(42, 39, 34, 0.04);
}

.empty-upload {
  padding: 28rpx;
}

.fixture-entry {
  margin-top: 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.fixture-btn {
  flex: 0 0 112rpx;
  height: 62rpx;
  border-radius: 18rpx;
  background: #527858;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
}

.photo-quality-warning,
.upload-error,
.notice {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  line-height: 1.45;
}

.notice {
  background: #E7EEE5;
  color: #527858;
}

.photo-quality-warning,
.upload-error {
  background: #FFF2DE;
  color: #A96724;
}

.grouping-wrap {
  margin-top: 32rpx;
}

.group-count-text {
  margin-top: 22rpx;
  color: #6E675F;
  font-size: 26rpx;
  text-align: center;
}

.group-actions {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: 20rpx;
}

.group-actions .btn {
  height: 76rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
}

.strong {
  font-weight: 700;
}

.btn.disabled,
.fixture-btn.disabled {
  opacity: 0.58;
}

.bottom-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 22rpx 32rpx calc(22rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(247, 245, 242, 0) 0%, #F7F5F2 26%);
}

.bottom-action .btn {
  height: 88rpx;
  border-radius: 18rpx;
  background: linear-gradient(145deg, #638965 0%, #527858 100%);
  font-size: 31rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 18rpx rgba(50, 76, 51, 0.14);
}
