<view class="page upload-page">
  <view class="nav">
    <view class="nav-side left" bindtap="goBack">取消</view>
    <view class="nav-title">上传检查报告</view>
    <view class="nav-side right"></view>
  </view>
  <block wx:if="{{!grouping}}">
    <view class="pad mt-12">
      <view class="sub">默认每张图为独立报告。同一份报告的多页，点曲别针建立关联。</view>
      <view wx:if="{{hasDraft && photos.length > 0}}" class="draft-hint">已恢复上次未完成的上传草稿。</view>
      <view wx:if="{{uploadError}}" class="upload-error">{{uploadError}}</view>
    </view>
    <view class="pad mt-12">
      <view class="upload-actions">
        <view class="upload-action" bindtap="chooseCamera"><view class="upload-icon">拍</view><view>拍照</view><view class="tiny">使用相机</view></view>
        <view class="upload-action" bindtap="chooseAlbum"><view class="upload-icon">册</view><view>从相册</view><view class="tiny">可选多张</view></view>
      </view>
    </view>
    <view wx:if="{{photos.length > 0}}" class="section-title">已选 {{photos.length}} 张 → 将识别为 {{reportCount}} 份报告</view>
    <view wx:else class="section-title">已选 0 张</view>
    <view class="pad">
      <view class="photo-grid">
        <view wx:for="{{photos}}" wx:key="id" data-id="{{item.id}}" class="photo {{item.group ? 'grouped' : ''}}" bindtap="preview">
          <image wx:if="{{item.tempFilePath}}" class="photo-thumb" src="{{item.tempFilePath}}" mode="aspectFill" />
          <view wx:if="{{item.group}}" class="group-label">组 {{item.group}}</view>
          <view class="photo-index">第 {{item.id}} 张</view>
          <view class="clip" catchtap="startGrouping">⌘</view>
        </view>
        <view class="photo add" bindtap="chooseAlbum">+</view>
      </view>
    </view>
    <view class="pad mt-12">
      <view wx:if="{{photos.length > 0}}" class="tiny">点击图片放大预览；点曲别针，再点其他图，建立“同一份报告”关联。</view>
      <view wx:else class="empty-upload">
        <view class="body strong">还没有选择报告图片</view>
        <view class="tiny mt-8">请先拍照或从相册选择检查报告，再开始识别。</view>
      </view>
      <view wx:if="{{showFixtureEntry}}" class="fixture-entry">
        <view>
          <view class="body strong">真实样例识别结果</view>
          <view class="tiny mt-8">绕过上传和 OCR，直接进入 7 份真实报告的确认流程。</view>
        </view>
        <view class="fixture-btn {{loading ? 'disabled' : ''}}" bindtap="startFixtureOcr">载入</view>
      </view>
    </view>
  </block>
  <block wx:else>
    <view class="pad mt-12">
      <view class="notice">正在建立关联：按拍摄顺序点击属于同一份报告的图片</view>
    </view>
    <view class="pad mt-16">
      <view class="photo-grid">
        <view wx:for="{{photos}}" wx:key="id" data-id="{{item.id}}" class="photo {{item.isSelected ? 'selected' : ''}}" bindtap="toggleSelect">
          <image wx:if="{{item.tempFilePath}}" class="photo-thumb" src="{{item.tempFilePath}}" mode="aspectFill" />
          <view wx:if="{{item.isSelected}}" class="order-label">{{item.selectedOrder}}</view>
          <view class="photo-index">第 {{item.id}} 张</view>
        </view>
      </view>
      <view class="sub center mt-16">已选 {{selected.length}} 张，按选中顺序合并</view>
      <view class="group-actions">
        <view class="btn secondary" bindtap="cancelGrouping">取消</view>
        <view class="btn" bindtap="finishGrouping">完成合并</view>
      </view>
    </view>
  </block>
  <view class="bottom-action">
    <view class="btn {{photos.length === 0 || loading ? 'disabled' : ''}}" bindtap="startOcr">开始识别（{{photos.length}} 张 → {{reportCount}} 份报告）</view>
  </view>
</view>
