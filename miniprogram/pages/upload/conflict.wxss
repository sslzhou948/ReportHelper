.conflict-page {
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

.strong {
  font-weight: 700;
}

.conflict-card {
  margin-bottom: 22rpx;
  padding: 26rpx 22rpx 22rpx;
}

.conflict-card:last-child {
  margin-bottom: 0;
}

.conflict-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.conflict-name {
  flex: 1;
  min-width: 0;
  line-height: 1.28;
}

.conflict-count {
  flex: 0 0 auto;
  color: #6E675F;
  font-size: 24rpx;
  line-height: 1.2;
}

.conflict-message {
  margin-top: 12rpx;
  color: #A96724;
  line-height: 1.45;
}

.option {
  min-height: 92rpx;
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  border: 2rpx solid #E7E1D9;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.option.active {
  background: #F3F8F1;
  border-color: #527858;
  box-shadow: inset 0 0 0 1rpx rgba(82, 120, 88, 0.18);
}

.radio {
  flex: 0 0 auto;
  width: 34rpx;
  height: 34rpx;
  border-radius: 17rpx;
  border: 2rpx solid #A7ADA4;
  color: #527858;
  display: flex;
  align-items: center;
  justify-content: center;
}

.radio-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 9rpx;
  background: #527858;
}

.option-main {
  flex: 1;
  min-width: 0;
}

.option-line {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  min-width: 0;
}

.option-value {
  color: #24211D;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.15;
  word-break: break-all;
}

.option-unit {
  color: #6E675F;
  font-size: 24rpx;
  line-height: 1.2;
}

.option-meta {
  margin-top: 6rpx;
  color: #6E675F;
  line-height: 1.25;
}

.option-source {
  flex: 0 0 150rpx;
  color: #527858;
  font-size: 24rpx;
  line-height: 1.25;
  text-align: right;
}

.option-source.muted {
  color: #8F8880;
}

.delete-option {
  width: 100%;
  margin-top: 16rpx;
  height: 82rpx;
  padding: 0 22rpx;
  border-radius: 12rpx;
  border: 2rpx solid #E7E1D9;
  background: #FFFFFF;
  color: #6E675F;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 18rpx;
  font-size: 28rpx;
}

.delete-option.active {
  background: #FFF5E7;
  border-color: #E5B978;
  color: #A96724;
}

.bottom-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 22rpx 32rpx calc(22rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(247, 245, 242, 0) 0%, #F7F5F2 26%);
  border-top: 0;
}

.upload-ref-page {
  background: #F7F5F2;
  color: #24211D;
}

.upload-nav {
  position: relative;
  top: auto;
  min-height: 186rpx;
  padding: 122rpx 32rpx 20rpx;
  background: #F7F5F2;
  border-bottom: 0;
  box-shadow: none;
}

.upload-nav .nav-title {
  color: #1F1F1F;
  font-size: 36rpx;
  font-weight: 700;
}

.upload-nav .nav-side {
  color: #24211D;
  font-size: 30rpx;
  font-weight: 400;
}

.conflict-top {
  margin-top: 6rpx;
}

.detail-notice {
  width: 100%;
  min-height: 76rpx;
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  font-size: 25rpx;
  line-height: 1.38;
}

.detail-notice.info {
  background: #EAF1E8;
  color: #3F5F45;
}

.detail-notice-icon {
  flex: 0 0 auto;
  width: 36rpx;
  height: 36rpx;
  margin-top: 1rpx;
}

.detail-notice-text {
  flex: 1;
  min-width: 0;
}

.notice-subline {
  margin-top: 6rpx;
  color: #6E675F;
  font-size: 23rpx;
}

.conflict-section-title {
  margin: 28rpx 0 18rpx;
  padding: 0 32rpx;
  color: #24211D;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.25;
}

.conflict-page .card {
  border-radius: 20rpx;
  border-color: #E7E1D9;
  box-shadow: 0 6rpx 20rpx rgba(42, 39, 34, 0.04);
}

.conflict-head .body {
  color: #24211D;
  font-size: 31rpx;
  line-height: 1.25;
}

.option.active .radio,
.delete-option.active .radio {
  border-color: #527858;
}

.conflict-tip {
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  background: #FFF5E7;
  color: #7C5A32;
  font-size: 24rpx;
  line-height: 1.42;
}

.bottom-action .btn {
  height: 88rpx;
  border-radius: 18rpx;
  background: linear-gradient(145deg, #638965 0%, #527858 100%);
  font-size: 31rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 18rpx rgba(50, 76, 51, 0.14);
}

.btn.disabled {
  opacity: 0.58;
}
