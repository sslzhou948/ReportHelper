.conflict-page {
  padding-bottom: calc(192rpx + env(safe-area-inset-bottom));
}

.strong {
  font-weight: 800;
}

.conflict-card {
  margin-bottom: 20rpx;
}

.conflict-card:last-child {
  margin-bottom: 0;
}

.conflict-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.conflict-message {
  margin-top: 10rpx;
}

.option {
  margin-top: 16rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  border: 3rpx solid var(--border-soft);
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.option.active {
  background: var(--primary-soft);
  border-color: var(--primary);
}

.radio {
  flex: 0 0 auto;
  width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  border: 3rpx solid var(--primary);
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.option-main {
  min-width: 0;
}

.option-value {
  font-size: 36rpx;
  font-weight: 900;
  word-break: break-all;
}

.delete-option {
  width: 100%;
  margin-top: 16rpx;
  height: 88rpx;
  border-radius: 24rpx;
  border: 2rpx dashed var(--border);
  color: var(--ink-3);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
}

.delete-option.active {
  background: #FFF7ED;
  border-color: var(--warn);
  color: var(--warn);
}

.bottom-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid var(--border-soft);
}
