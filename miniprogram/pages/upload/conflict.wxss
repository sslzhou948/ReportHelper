.conflict-page {
  padding-bottom: 136rpx;
}

.strong {
  font-weight: 800;
}

.option {
  margin-top: 16rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  border: 3rpx solid var(--border-soft);
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.option.active {
  background: var(--primary-soft);
  border-color: var(--primary);
}

.radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  border: 3rpx solid var(--primary);
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.option-value {
  font-size: 36rpx;
  font-weight: 900;
}

.delete-option {
  width: 100%;
  margin-top: 16rpx;
  height: 88rpx;
  border-radius: 24rpx;
  border: 2rpx dashed var(--border);
  color: var(--ink-3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.bottom-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid var(--border-soft);
}
