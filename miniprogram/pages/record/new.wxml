<view class="page">
  <view class="nav">
    <view class="nav-side left" bindtap="goBack">‹ 返回</view>
    <view class="nav-title">新增记录</view>
    <view class="nav-side right"></view>
  </view>

  <network-banner offline="{{networkOffline}}" bind:retry="retryAfterNetwork" />
  <loading-slow-banner visible="{{loadingSlow}}" bind:retry="retrySlowLoading" bind:cancel="cancelSlowLoading" />

  <view class="pad mt-12">
    <view class="intro-card">
      <view class="title">新增健康记录</view>
      <view class="sub mt-8">有报告单就拍照识别；没有报告单，也可以手动录入数值、阴性/阳性或描述结果。</view>
    </view>
  </view>

  <view class="pad mt-12">
    <view class="entry-card" bindtap="goUpload">
      <view class="entry-icon">拍</view>
      <view class="flex">
        <view class="body strong">拍照识别报告</view>
        <view class="tiny">拍照 / 相册上传，识别后再确认归档</view>
      </view>
      <view class="arrow">›</view>
    </view>
  </view>

  <view class="pad mt-12">
    <view class="entry-card manual-entry-card" bindtap="goManual">
      <view class="entry-icon manual">录</view>
      <view class="flex">
        <view class="body strong">手动录入检查结果</view>
        <view class="tiny">选择检查项后填写本次数值或描述</view>
      </view>
      <view class="arrow">›</view>
    </view>
  </view>
</view>
