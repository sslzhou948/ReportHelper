.action-page {
  padding-bottom: calc(176rpx + env(safe-area-inset-bottom));
}

.manual-entry-page {
  background: #F7F5F2;
  color: #24211D;
}

.manual-entry-nav {
  position: relative;
  top: auto;
  min-height: 186rpx;
  padding: 122rpx 32rpx 20rpx;
  background: #F7F5F2;
  border-bottom: 0;
  box-shadow: none;
}

.manual-entry-nav .nav-title {
  color: #1F1F1F;
  font-size: 36rpx;
  font-weight: 700;
}

.manual-entry-nav .nav-side {
  color: #24211D;
  font-size: 30rpx;
  font-weight: 400;
}

.manual-hero-pad {
  margin-top: 0;
}

.template-hero {
  min-height: 144rpx;
  padding: 24rpx 34rpx;
  border-radius: 28rpx;
  border: 0;
  background: linear-gradient(135deg, #EDF4EA 0%, #E5EDE1 100%);
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: none;
}

.template-hero-icon {
  flex: 0 0 auto;
  width: 84rpx;
  height: 84rpx;
}

.template-hero-main {
  flex: 1;
  min-width: 0;
}

.template-hero-title {
  color: #24211D;
  font-size: 38rpx;
  line-height: 1.18;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.template-hero-sub {
  margin-top: 10rpx;
  color: #6E675F;
  font-size: 27rpx;
  line-height: 1.25;
  font-weight: 400;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.manual-section-title {
  justify-content: flex-start;
  gap: 12rpx;
  margin: 36rpx 0 16rpx;
  color: #24211D;
  font-size: 32rpx;
  font-weight: 700;
}

.section-marker {
  width: 8rpx;
  height: 34rpx;
  border-radius: 8rpx;
  background: #5A7A5A;
}

.form-card {
  border-radius: 22rpx;
  border: 1rpx solid #E7E1D9;
  box-shadow: 0 8rpx 24rpx rgba(42, 39, 34, 0.045);
  overflow: hidden;
}

.form-row {
  min-height: 100rpx;
  padding: 18rpx 24rpx;
  gap: 16rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #E7E1D9;
  box-sizing: border-box;
}

.form-row:last-child {
  border-bottom: 0;
}

.field-icon {
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
  opacity: 0.94;
}

.field-label {
  flex: 0 0 136rpx;
  width: 136rpx;
  color: #24211D;
  font-size: 29rpx;
  font-weight: 400;
  line-height: 1.25;
}

.field-control {
  flex: 1;
  min-width: 0;
  display: flex;
  justify-content: flex-end;
}

.field-value {
  width: 100%;
  min-height: 62rpx;
  line-height: 62rpx;
  color: #24211D;
  font-size: 30rpx;
  font-weight: 400;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.field-input {
  flex: 1;
  min-width: 0;
  height: 62rpx;
  line-height: 62rpx;
  text-align: right;
  color: #24211D;
  font-size: 30rpx;
  font-weight: 400;
}

.field-input.value {
  font-size: 34rpx;
  font-weight: 600;
  color: #2F4F37;
}

.field-chevron {
  flex: 0 0 auto;
  width: 24rpx;
  color: #8A827A;
  font-size: 40rpx;
  font-weight: 400;
  line-height: 1;
  text-align: right;
}

.custom-source {
  color: #5A7A5A;
  font-weight: 600;
}

.text-form-row {
  padding: 22rpx 24rpx 26rpx;
  border-bottom: 1rpx solid #E7E1D9;
  background: #FFFFFF;
  box-sizing: border-box;
}

.text-form-row .field-label {
  width: auto;
  flex: none;
}

.text-form-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.text-input {
  width: 100%;
  height: 152rpx;
  min-height: 152rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #FAF8F4;
  border: 1rpx solid #E7E1D9;
  box-sizing: border-box;
  color: #24211D;
  font-size: 29rpx;
  font-weight: 400;
  line-height: 1.55;
}

.compact-text-row .text-input {
  height: 120rpx;
  min-height: 120rpx;
}

.ref-text-input {
  color: #24211D;
}

.ref-row {
  gap: 14rpx;
}

.ref-input {
  width: 120rpx;
  height: 60rpx;
  padding: 0 14rpx;
  border-radius: 14rpx;
  background: #FFFFFF;
  border: 1rpx solid #E7E1D9;
  text-align: center;
  color: #24211D;
  font-size: 30rpx;
  font-weight: 400;
}

.range-dash {
  color: #8A827A;
  font-size: 30rpx;
  line-height: 1;
}

.bottom-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(22rpx + env(safe-area-inset-bottom));
  display: grid;
  grid-template-columns: 1fr 1.38fr;
  gap: 28rpx;
  background: rgba(247, 245, 242, 0.96);
  border-top: 0;
  z-index: 20;
}

.bottom-action .btn {
  height: 92rpx;
  border-radius: 22rpx;
  font-size: 31rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(54, 83, 58, 0.18);
}

.btn-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
}

.primary-icon {
  opacity: 0.96;
}

.bottom-action .btn.secondary {
  box-shadow: none;
  border: 2rpx solid #5A7A5A;
}
