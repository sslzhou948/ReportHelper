.profile-card-head {
  display: flex;
  gap: 24rpx;
  align-items: flex-start;
}

.avatar-large {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50rpx;
  background: var(--primary);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 800;
}

.mini-btn {
  flex: 0 0 auto;
  align-self: flex-start;
  min-width: 88rpx;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 28rpx;
  background: var(--primary-soft);
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.stats {
  margin-top: 32rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid var(--border-soft);
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  text-align: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 900;
}

.arrow {
  color: var(--ink-3);
  font-size: 40rpx;
}

.danger {
  color: var(--high);
}

.logout {
  color: var(--high);
}

.dev-card {
  overflow: hidden;
}

.dev-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.dev-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink);
}

.dev-status {
  flex: 0 0 auto;
  max-width: 180rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #F7F5F0;
  color: var(--ink-3);
  font-size: 22rpx;
  line-height: 1.3;
  text-align: center;
}

.dev-status.ok {
  background: var(--primary-soft);
  color: var(--primary);
}

.dev-segment {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.dev-option {
  min-width: 0;
  height: 64rpx;
  border-radius: 16rpx;
  background: #F7F5F0;
  color: var(--ink-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}

.dev-option.active {
  background: var(--primary);
  color: #FFFFFF;
}

.compact {
  min-height: 80rpx;
  padding-left: 0;
  padding-right: 0;
}

.dev-url {
  max-width: 360rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: right;
}
