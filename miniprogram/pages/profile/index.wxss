.profile-ref-page {
  background: #F7F5F2;
}

.profile-hero {
  position: relative;
  height: 250rpx;
  min-height: 250rpx;
  padding: calc(var(--safe-top) - 98rpx) 36rpx 0;
  color: #FFFFFF;
  background:
    radial-gradient(circle at 38% -20%, rgba(255, 255, 255, 0.15), transparent 38%),
    linear-gradient(145deg, #739672 0%, #638965 48%, #527858 100%);
  box-shadow: 0 10rpx 24rpx rgba(59, 82, 59, 0.14);
  box-sizing: border-box;
}

.profile-nav {
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-title {
  color: #F7FAF7;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.2;
  text-align: center;
  text-shadow: 0 2rpx 8rpx rgba(32, 62, 38, 0.12);
}

.profile-shell {
  position: relative;
  z-index: 1;
  min-height: calc(100vh - 190rpx);
  margin-top: -56rpx;
  padding-top: 58rpx;
  background: #F7F5F2;
  border-top-left-radius: 58rpx;
  border-top-right-radius: 58rpx;
  overflow: hidden;
}

.profile-pad {
  padding: 0 38rpx;
}

.profile-card-wrap {
  margin-top: 0;
}

.profile-card,
.profile-menu-card,
.profile-dev-card {
  width: 100%;
  max-width: none;
  margin: 0;
  background: #FFFFFF;
  border: 1rpx solid #ECE7DF;
  box-shadow: 0 10rpx 28rpx rgba(42, 39, 34, 0.055);
  overflow: hidden;
  box-sizing: border-box;
}

.profile-card {
  padding: 34rpx 30rpx 0;
  border-radius: 34rpx;
}

.profile-card-head {
  min-height: 138rpx;
  display: flex;
  align-items: flex-start;
  gap: 30rpx;
}

.profile-avatar {
  flex: 0 0 auto;
  width: 126rpx;
  height: 126rpx;
  border-radius: 50%;
}

.profile-main {
  flex: 1;
  min-width: 0;
  padding-top: 6rpx;
}

.profile-name {
  color: #24211D;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.15;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.profile-summary,
.profile-relation {
  color: #726B64;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.profile-summary {
  margin-top: 18rpx;
}

.profile-relation {
  margin-top: 13rpx;
}

.profile-edit {
  flex: 0 0 auto;
  align-self: flex-start;
  height: 60rpx;
  min-width: 104rpx;
  padding: 0 4rpx 0 18rpx;
  color: #527858;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
}

.profile-edit-chevron {
  font-size: 46rpx;
  font-weight: 500;
  line-height: 1;
}

.profile-stats {
  height: 122rpx;
  margin-top: 26rpx;
  border-top: 1rpx solid #E8E2DA;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  align-items: center;
}

.profile-stat {
  position: relative;
  min-width: 0;
  text-align: center;
}

.profile-stat + .profile-stat::before {
  content: "";
  position: absolute;
  left: 0;
  top: 12rpx;
  width: 1rpx;
  height: 56rpx;
  background: #E0DAD2;
}

.profile-stat-num {
  color: #527858;
  font-size: 39rpx;
  font-weight: 800;
  line-height: 1;
}

.profile-stat-label {
  margin-top: 13rpx;
  color: #726B64;
  font-size: 27rpx;
  font-weight: 400;
  line-height: 1;
}

.profile-section {
  margin-top: 24rpx;
}

.profile-section-title {
  min-height: 38rpx;
  padding: 0 40rpx;
  color: #24211D;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.profile-menu-card,
.profile-dev-card {
  border-radius: 28rpx;
}

.profile-menu-card {
  margin-top: 12rpx;
}

.profile-menu-row {
  min-height: 88rpx;
  padding: 14rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-bottom: 1rpx solid #E7E1D9;
  background: #FFFFFF;
}

.profile-menu-row:last-child {
  border-bottom: 0;
}

.profile-menu-icon {
  flex: 0 0 auto;
  width: 48rpx;
  height: 48rpx;
}

.profile-menu-label {
  flex: 0 1 auto;
  min-width: 0;
  max-width: 248rpx;
  color: #27241F;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.profile-menu-value {
  flex: 1;
  min-width: 0;
  color: #756E67;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.2;
  text-align: right;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.profile-chevron {
  flex: 0 0 auto;
  width: 28rpx;
  color: #8A827A;
  font-size: 45rpx;
  line-height: 1;
  text-align: right;
}

.profile-menu-row.danger .profile-menu-label,
.profile-menu-row.danger .profile-chevron {
  color: #D84D43;
}

.profile-logout-wrap {
  margin-top: 28rpx;
  padding-bottom: 18rpx;
}

.profile-logout-card {
  width: 100%;
  max-width: none;
  margin: 0;
  height: 96rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  border: 1rpx solid #ECE7DF;
  box-shadow: 0 10rpx 28rpx rgba(42, 39, 34, 0.055);
  color: #D84D43;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  font-size: 31rpx;
  font-weight: 400;
  line-height: 1;
  overflow: hidden;
  box-sizing: border-box;
}

.profile-logout-icon {
  width: 52rpx;
  height: 52rpx;
}

.dev-section {
  margin-top: 18rpx;
  padding-bottom: 28rpx;
}

.profile-dev-card {
  margin-top: 16rpx;
  padding: 28rpx;
}

.dev-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.dev-title {
  color: #24211D;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.2;
}

.dev-sub {
  margin-top: 8rpx;
  color: #837C74;
  font-size: 24rpx;
  line-height: 1.3;
}

.dev-status {
  flex: 0 0 auto;
  max-width: 180rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #F2EEE7;
  color: #837C74;
  font-size: 22rpx;
  line-height: 1.3;
  text-align: center;
}

.dev-status.ok {
  background: #E7EEE5;
  color: #527858;
}

.dev-segment {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.dev-option {
  min-width: 0;
  height: 64rpx;
  border-radius: 16rpx;
  background: #F2EEE7;
  color: #5F5953;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}

.dev-option.active {
  background: linear-gradient(145deg, #6D946D 0%, #527858 100%);
  color: #FFFFFF;
}

.dev-row {
  min-height: 82rpx;
  padding: 16rpx 0;
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-top: 1rpx solid #E7E1D9;
}

.dev-label {
  flex: 0 0 auto;
  color: #27241F;
  font-size: 28rpx;
  line-height: 1.2;
}

.dev-value {
  flex: 1;
  min-width: 0;
  color: #837C74;
  font-size: 24rpx;
  line-height: 1.2;
  text-align: right;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
