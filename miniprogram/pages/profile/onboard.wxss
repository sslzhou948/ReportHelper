.onboard-page {
  min-height: 100vh;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.guest-state {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #F4EFE4;
}

.guest-visual {
  position: relative;
  width: 100%;
  height: 1098rpx;
  overflow: hidden;
}

.guest-visual-image {
  width: 100%;
  display: block;
}

.guest-login-card {
  position: relative;
  z-index: 2;
  margin: 30rpx 30rpx 0;
  padding: 34rpx 52rpx 38rpx;
  border: 0;
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 22rpx 70rpx rgba(68, 58, 42, 0.12);
  text-align: center;
}

.login-card-mark {
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.login-card-emblem {
  width: 220rpx;
  height: 80rpx;
  display: block;
}

.login-card-title {
  color: #2E3432;
  font-size: 37rpx;
  font-weight: 900;
  line-height: 1.28;
}

.login-card-copy {
  margin-top: 16rpx;
  color: var(--ink-2);
  font-size: 25rpx;
  line-height: 1.45;
}

.login-card-divider {
  height: 1rpx;
  margin: 28rpx 32rpx 0;
  border-top: 2rpx dashed #E3DFD8;
}

.agreement-row {
  min-height: 48rpx;
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.checkbox {
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--border);
  background: #FFFFFF;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 900;
}

.checkbox.checked {
  border-color: var(--primary);
  background: var(--primary);
}

.agreement-copy {
  flex: 1;
  min-width: 0;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 40rpx;
  text-align: left;
}

.agreement-link {
  margin: 0 6rpx;
  color: var(--primary);
  font-weight: 800;
}

.btn.disabled {
  opacity: 0.58;
}

.onboard-banner {
  min-height: 312rpx;
}

.white {
  color: rgba(255, 255, 255, 0.9);
}

.choice {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.choice-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: var(--primary-soft);
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
}

.choice-icon.warm {
  background: #FAF5EC;
  color: #C99B5C;
}

.arrow {
  color: var(--ink-3);
  font-size: 40rpx;
}

.preview-row {
  min-height: 96rpx;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--border-soft);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.preview-row:last-child {
  border-bottom: 0;
}

.checking-state {
  min-height: 100vh;
  padding: 220rpx 32rpx 0;
  text-align: center;
}
