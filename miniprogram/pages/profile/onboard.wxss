.onboard-page {
  min-height: 100vh;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.guest-state {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: linear-gradient(180deg, rgba(90, 122, 90, 0.06) 0%, rgba(90, 122, 90, 0) 56%), var(--bg);
}

.guest-hero {
  position: relative;
  min-height: 752rpx;
  padding: 116rpx 44rpx 0;
  overflow: hidden;
  background: linear-gradient(160deg, #6B8E6B 0%, #5A7A5A 100%);
  color: #FFFFFF;
  border-bottom-left-radius: 68rpx;
  border-bottom-right-radius: 68rpx;
}

.guest-hero::after {
  content: "";
  position: absolute;
  left: 56rpx;
  right: 56rpx;
  bottom: 64rpx;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.18);
}

.guest-title {
  margin-top: 68rpx;
  font-size: 56rpx;
  font-weight: 900;
  line-height: 1.12;
  letter-spacing: 0;
}

.guest-copy {
  max-width: 570rpx;
  margin-top: 28rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 28rpx;
  line-height: 1.65;
}

.record-stack {
  position: absolute;
  left: 60rpx;
  right: 60rpx;
  bottom: -44rpx;
  height: 300rpx;
}

.record-card {
  position: absolute;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  box-shadow: 0 36rpx 76rpx rgba(41, 55, 38, 0.22);
}

.record-card.back {
  left: 48rpx;
  right: 12rpx;
  top: 44rpx;
  height: 208rpx;
  opacity: 0.62;
  transform: rotate(4deg);
}

.record-card.front {
  left: 0;
  right: 48rpx;
  top: 0;
  height: 252rpx;
  padding: 32rpx;
  color: var(--ink);
}

.record-line {
  height: 16rpx;
  margin-top: 20rpx;
  border-radius: 16rpx;
  background: #E7E3DC;
}

.record-line.short {
  width: 48%;
}

.record-line.mid {
  width: 72%;
}

.record-metric {
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--ink-2);
  font-size: 24rpx;
}

.record-pill {
  width: 116rpx;
  height: 44rpx;
  border-radius: 24rpx;
  background: var(--high-soft);
  color: var(--high);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 800;
}

.guest-features {
  position: relative;
  z-index: 3;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin: -52rpx 32rpx 0;
}

.feature-card {
  min-height: 140rpx;
  padding: 22rpx 20rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(229, 225, 218, 0.92);
  box-shadow: 0 20rpx 52rpx rgba(51, 45, 35, 0.08);
  display: grid;
  grid-template-columns: 64rpx 1fr;
  gap: 16rpx;
  align-items: center;
}

.feature-card.wide {
  grid-column: 1 / -1;
  min-height: 128rpx;
}

.feature-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 22rpx;
  background: var(--primary-soft);
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
}

.feature-title {
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.35;
}

.feature-copy {
  margin-top: 4rpx;
  color: var(--ink-3);
  font-size: 20rpx;
  line-height: 1.4;
}

.guest-login-card {
  position: relative;
  z-index: 2;
  margin: 28rpx 32rpx 0;
  border-radius: 48rpx;
  box-shadow: 0 20rpx 68rpx rgba(51, 45, 35, 0.10);
}

.guest-muted {
  margin: 20rpx 32rpx 0;
  padding: 28rpx;
  border: 1rpx dashed var(--border);
  border-radius: 32rpx;
  background: #F7F4EE;
}

.agreement-row {
  min-height: 48rpx;
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.checkbox {
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--border);
  background: #FFFFFF;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 900;
}

.checkbox.checked {
  border-color: var(--primary);
  background: var(--primary);
}

.agreement-copy {
  flex: 1;
  min-width: 0;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 40rpx;
}

.agreement-link {
  margin: 0 6rpx;
  color: var(--primary);
  font-weight: 800;
}

.btn.disabled {
  opacity: 0.58;
}

.onboard-banner {
  min-height: 312rpx;
}

.white {
  color: rgba(255, 255, 255, 0.9);
}

.choice {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.choice-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: var(--primary-soft);
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
}

.choice-icon.warm {
  background: #FAF5EC;
  color: #C99B5C;
}

.arrow {
  color: var(--ink-3);
  font-size: 40rpx;
}

.preview-row {
  min-height: 96rpx;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--border-soft);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.preview-row:last-child {
  border-bottom: 0;
}

.checking-state {
  min-height: 100vh;
  padding: 220rpx 32rpx 0;
  text-align: center;
}
