.onboard-banner {
  min-height: 360rpx;
}

.white {
  color: rgba(255, 255, 255, 0.9);
}

.choice {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.choice-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: var(--primary-soft);
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
}

.choice-icon.warm {
  background: #FAF5EC;
  color: #C99B5C;
}

.choice-icon.muted {
  background: #FFFFFF;
  border: 3rpx solid var(--border);
  color: var(--ink-3);
}

.strong {
  font-weight: 700;
}

.arrow {
  color: var(--ink-3);
  font-size: 40rpx;
}

.agreement-links {
  padding: 0 12rpx;
  color: var(--primary);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.link-sep {
  margin: 0 10rpx;
  color: var(--ink-3);
  font-weight: 500;
}

.center {
  text-align: center;
}
