.onboard-banner {
  min-height: 312rpx;
}

.white {
  color: rgba(255, 255, 255, 0.9);
}

.intro-card {
  padding: 28rpx 0 4rpx;
}

.choice {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.choice.selected {
  border-color: rgba(90, 122, 90, 0.44);
  box-shadow: 0 8rpx 24rpx rgba(90, 122, 90, 0.12);
}

.choice-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: var(--primary-soft);
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
}

.choice-icon.warm {
  background: #FAF5EC;
  color: #C99B5C;
}

.strong {
  font-weight: 700;
}

.arrow {
  color: var(--ink-3);
  font-size: 40rpx;
}

.onboard-footer {
  margin-top: 44rpx;
  padding: 8rpx 0 24rpx;
}

.agreement-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 48rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--border);
  background: #FFFFFF;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
}

.checkbox.checked {
  border-color: var(--primary);
  background: var(--primary);
}

.agreement-copy {
  flex: 1;
  min-width: 0;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 40rpx;
}

.agreement-link {
  margin: 0 6rpx;
  color: var(--primary);
  font-weight: 700;
}

.btn.disabled {
  opacity: 0.46;
}

.center {
  text-align: center;
}
