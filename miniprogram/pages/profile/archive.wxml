<view class="page">
  <view class="nav">
    <view class="nav-side left" bindtap="goBack">‹ 返回</view>
    <view class="nav-title">档案资料</view>
    <view class="nav-side right" bindtap="save">保存</view>
  </view>
  <view class="pad mt-12">
    <view class="notice">本页数据仅用于健康记录参考，严格遵守隐私保护</view>
  </view>
  <view class="section-title">基本与病情信息</view>
  <view class="pad">
    <view class="card form-card">
      <view class="form-row">
        <view class="sub label">姓名</view>
        <input class="field-input" value="{{form.realName}}" placeholder="未填写" data-key="realName" bindinput="inputField" />
      </view>
      <view class="form-row">
        <view class="sub label">性别</view>
        <picker class="field-control" mode="selector" range="{{genderOptions}}" range-key="label" value="{{genderIndex}}" bindchange="pickGender">
          <view class="field-value {{form.gender ? '' : 'placeholder'}}">{{genderText}}</view>
        </picker>
      </view>
      <view class="form-row">
        <view class="sub label">出生日期</view>
        <picker class="field-control" mode="date" value="{{form.birthDate}}" end="{{today}}" data-key="birthDate" bindchange="pickDate">
          <view class="field-value {{form.birthDate ? '' : 'placeholder'}}">{{form.birthDate || '未填写'}}</view>
        </picker>
      </view>
      <view class="form-row">
        <view class="sub label">病种</view>
        <input class="field-input" value="{{form.diseaseType}}" placeholder="未填写" data-key="diseaseType" bindinput="inputField" />
      </view>
      <view class="form-row">
        <view class="sub label">确诊日期</view>
        <picker class="field-control" mode="date" value="{{form.diagnosedAt}}" end="{{today}}" data-key="diagnosedAt" bindchange="pickDate">
          <view class="field-value {{form.diagnosedAt ? '' : 'placeholder'}}">{{form.diagnosedAt || '未填写'}}</view>
        </picker>
      </view>
      <view class="form-row">
        <view class="sub label">分期</view>
        <picker class="field-control" mode="selector" range="{{stageOptions}}" range-key="label" value="{{stageIndex}}" bindchange="pickStage">
          <view class="field-value {{form.stage ? '' : 'placeholder'}}">{{stageText}}</view>
        </picker>
      </view>
      <view class="form-row">
        <view class="sub label">治疗阶段</view>
        <picker class="field-control" mode="selector" range="{{phaseOptions}}" range-key="label" value="{{phaseIndex}}" bindchange="pickPhase">
          <view class="field-value {{form.treatmentPhase ? '' : 'placeholder'}}">{{phaseText}}</view>
        </picker>
      </view>
      <view class="form-row">
        <view class="sub label">主治医院</view>
        <input class="field-input" value="{{form.primaryHospital}}" placeholder="未填写" data-key="primaryHospital" bindinput="inputField" />
      </view>
      <view class="form-row">
        <view class="sub label">主治医生</view>
        <input class="field-input" value="{{form.primaryDoctor}}" placeholder="未填写" data-key="primaryDoctor" bindinput="inputField" />
      </view>
      <view class="form-row">
        <view class="sub label">科室</view>
        <input class="field-input" value="{{form.primaryDepartment}}" placeholder="未填写" data-key="primaryDepartment" bindinput="inputField" />
      </view>
    </view>
  </view>
  <view class="section-title">
    <view>用药记录</view>
  </view>
  <view class="pad">
    <view class="card">
      <view wx:for="{{medications}}" wx:key="id" class="row">
        <view class="flex">
          <view class="body strong">{{item.name}}</view>
          <view class="tiny">{{item.dose}} · {{item.frequency}} · {{item.startedAt}}</view>
        </view>
      </view>
      <view wx:if="{{medications.length === 0}}" class="row">
        <view class="flex">
          <view class="body strong">暂无用药记录</view>
          <view class="tiny">如需记录，可先写入备注或病情信息</view>
        </view>
      </view>
    </view>
  </view>
  <view class="pad mt-16">
    <view class="btn {{saving ? 'disabled' : ''}}" bindtap="save">保存档案</view>
  </view>
</view>
