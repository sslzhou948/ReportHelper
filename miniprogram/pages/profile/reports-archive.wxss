.archive-content {
  padding: 24rpx 32rpx 40rpx;
}

.archive-notice {
  min-height: 80rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-radius: 28rpx;
  background: #fbf0dd;
  color: #7d4f22;
}

.notice-icon {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.9;
  flex: 0 0 auto;
}

.notice-text {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  line-height: 1.45;
}

.archive-tools {
  margin-top: 24rpx;
  display: flex;
  gap: 18rpx;
  align-items: center;
}

.archive-search {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  border: 2rpx solid #d8d2c9;
  border-radius: 24rpx;
  background: #fffdf9;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.78;
  flex: 0 0 auto;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  color: var(--ink);
  font-size: 28rpx;
  line-height: 68rpx;
}

.archive-filter {
  height: 72rpx;
  min-width: 168rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border: 2rpx solid #d8d2c9;
  border-radius: 24rpx;
  background: #fffdf9;
  color: var(--primary);
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
}

.filter-icon {
  width: 32rpx;
  height: 32rpx;
}

.filter-arrow {
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1;
  transform: translateY(-2rpx);
}

.archive-month {
  margin-top: 27rpx;
}

.archive-month-head {
  min-height: 47rpx;
  padding: 0 31rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.archive-month-title {
  color: #24211d;
  font-size: 33rpx;
  font-weight: 800;
  line-height: 1.2;
}

.archive-month-count {
  color: #4f4841;
  font-size: 25rpx;
  line-height: 1;
}

.archive-card {
  margin-top: 14rpx;
  background: #fffdf9;
  border: 1rpx solid #e4ded4;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(60, 54, 48, 0.08);
  overflow: hidden;
}

.archive-row {
  min-height: 120rpx;
  padding: 20rpx 22rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-bottom: 1rpx solid #e7e1d9;
}

.archive-row:last-child {
  border-bottom: 0;
}

.date-tile {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: #f0eeeb;
  color: #2d2925;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}

.date-day {
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
}

.date-week {
  margin-top: 5rpx;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
}

.report-icon {
  width: 34rpx;
  height: 34rpx;
  flex: 0 0 auto;
}

.report-main {
  flex: 1;
  min-width: 0;
}

.report-title {
  color: #27241f;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.report-meta {
  margin-top: 7rpx;
  color: #847b73;
  font-size: 23rpx;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-badge {
  flex: 0 0 auto;
  min-width: 0;
  min-height: 37rpx;
  padding: 6rpx 17rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.08;
  white-space: nowrap;
}

.status-badge.high {
  background: #f7e4dd;
  color: #c45f4f;
}

.status-badge.normal {
  background: #edf3eb;
  color: var(--primary);
}

.status-badge.muted {
  background: #f1eee8;
  color: var(--ink-2);
}

.archive-arrow {
  color: #6c655d;
  font-size: 40rpx;
  line-height: 1;
  flex: 0 0 auto;
}

.archive-empty {
  margin-top: 28rpx;
  min-height: 180rpx;
  border-radius: 24rpx;
  background: rgba(255, 253, 249, 0.72);
  border: 1rpx dashed #d8d2c9;
  color: var(--ink-3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}
