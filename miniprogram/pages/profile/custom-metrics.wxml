<view class="page">
  <view class="nav">
    <view class="nav-side left" bindtap="goBack">‹ 返回</view>
    <view class="nav-title">{{pageTitle}}</view>
    <view class="nav-side right" bindtap="startCreate">新增</view>
  </view>

  <network-banner offline="{{networkOffline}}" bind:retry="retryAfterNetwork" />
  <loading-slow-banner visible="{{loadingSlow}}" bind:retry="retrySlowLoading" bind:cancel="cancelSlowLoading" />

  <view class="pad mt-12">
    <input class="search-input" value="{{keyword}}" placeholder="搜索录入模板" bindinput="onSearchInput" />
  </view>

  <view wx:if="{{editing}}" class="pad mt-12">
    <view class="card card-pad edit-card">
      <view class="title">{{formTitle}}</view>
      <view class="form-row">
        <view class="label">模板名称</view>
        <input class="form-input" value="{{form.metricName}}" placeholder="如 XX血药浓度、胸部CT" data-field="metricName" bindinput="onFormInput" />
      </view>
      <view class="form-row two">
        <view>
          <view class="label">检查类型</view>
          <picker range="{{categoryLabels}}" value="{{form.categoryIndex}}" bindchange="onCategoryChange">
            <view class="form-input picker-value">{{form.categoryCn}}</view>
          </picker>
        </view>
        <view wx:if="{{form.category === 'lab'}}">
          <view class="label">检验结果类型</view>
          <picker range="{{labValueTypeLabels}}" value="{{form.valueTypeIndex}}" bindchange="onValueTypeChange">
            <view class="form-input picker-value">{{form.valueTypeLabel}}</view>
          </picker>
        </view>
        <view wx:else>
          <view class="label">记录字段</view>
          <view class="form-input picker-value">{{form.valueTypeLabel}}</view>
        </view>
      </view>
      <view wx:if="{{form.category === 'lab'}}" class="form-row">
        <view class="label">默认单位</view>
        <input class="form-input" value="{{form.unit}}" placeholder="如 ng/mL、mmol/L，可不填" data-field="unit" bindinput="onFormInput" />
      </view>
      <view wx:if="{{form.category === 'lab' && form.valueType === 'quantitative'}}" class="form-row">
        <view class="label">参考范围模式</view>
        <picker range="{{refModeLabels}}" value="{{form.refModeIndex}}" bindchange="onRefModeChange">
          <view class="form-input picker-value">{{form.refModeLabel}}</view>
        </picker>
      </view>
      <view wx:if="{{form.category === 'lab' && form.valueType === 'quantitative' && form.refMode === 'simple_range'}}" class="form-row">
        <view class="label">区间范围</view>
        <view class="range-inputs">
          <input class="form-input" type="digit" value="{{form.refRangeLow}}" placeholder="下限" data-field="refRangeLow" bindinput="onFormInput" />
          <view class="range-dash">-</view>
          <input class="form-input" type="digit" value="{{form.refRangeHigh}}" placeholder="上限" data-field="refRangeHigh" bindinput="onFormInput" />
        </view>
      </view>
      <view wx:elif="{{form.category === 'lab' && form.valueType === 'quantitative' && form.refMode === 'upper_bound'}}" class="form-row">
        <view class="label">参考上限</view>
        <input class="form-input" type="digit" value="{{form.refRangeHigh}}" placeholder="如 5.6" data-field="refRangeHigh" bindinput="onFormInput" />
      </view>
      <view wx:elif="{{form.category === 'lab' && form.valueType === 'quantitative' && form.refMode === 'lower_bound'}}" class="form-row">
        <view class="label">参考下限</view>
        <input class="form-input" type="digit" value="{{form.refRangeLow}}" placeholder="如 40" data-field="refRangeLow" bindinput="onFormInput" />
      </view>
      <view wx:elif="{{form.category === 'lab' && form.valueType === 'quantitative' && form.refMode === 'complex_text'}}" class="form-row">
        <view class="label">参考范围原文</view>
        <textarea class="form-textarea" value="{{form.refText}}" placeholder="如 按年龄、孕周、周期阶段分段的参考范围" data-field="refText" bindinput="onFormInput" />
      </view>
      <view wx:elif="{{form.category === 'lab' && form.valueType === 'qualitative'}}" class="form-row">
        <view class="label">默认参考</view>
        <input class="form-input" value="{{form.refQualitative}}" placeholder="如 阴性" data-field="refQualitative" bindinput="onFormInput" />
      </view>
      <view wx:if="{{form.category !== 'lab'}}" class="form-row">
        <view class="label">描述提示</view>
        <input class="form-input" value="{{form.refText}}" placeholder="如 填写影像所见或医生结论" data-field="refText" bindinput="onFormInput" />
      </view>
      <view class="form-actions">
        <view class="btn secondary compact" bindtap="cancelEdit">取消</view>
        <view class="btn compact" bindtap="saveTemplate">{{saveText}}</view>
      </view>
    </view>
  </view>

  <view class="section-title">
    <view>{{sectionTitle}}</view>
    <view class="tiny">{{filteredItems.length}} 项</view>
  </view>
  <view class="pad">
    <view class="card">
      <view wx:for="{{filteredItems}}" wx:key="metricKey" class="row metric-row" data-key="{{item.metricKey}}" bindtap="selectMetric">
        <view class="metric-dot {{item.source}}">{{item.sourceText}}</view>
        <view class="flex">
          <view class="body strong">{{item.metricName}}</view>
          <view class="tiny">{{item.categoryCn}}<text wx:if="{{item.unit}}"> · {{item.unit}}</text><text wx:if="{{item.refDisplay && item.refDisplay !== '--'}}"> · 参考 {{item.refDisplay}}</text><text wx:if="{{item.measureCount}}"> · 已记录 {{item.measureCount}} 次</text></view>
        </view>
        <view wx:if="{{item.source === 'custom'}}" class="pill primary">自定义</view>
        <view wx:if="{{isManageMode && item.source === 'custom'}}" class="mini-link" catchtap="editMetric" data-key="{{item.metricKey}}">编辑</view>
        <view wx:if="{{isManageMode && item.source === 'custom'}}" class="delete-link" catchtap="deleteMetric" data-key="{{item.metricKey}}">删除</view>
        <view wx:if="{{isSelectMode}}" class="arrow">›</view>
      </view>
      <view wx:if="{{filteredItems.length === 0}}" class="empty-block">
        <view class="body strong">没有找到录入模板</view>
        <view class="tiny mt-8">可以新建一个手动录入模板，之后每次录入都能复用默认单位和参考值。</view>
        <view class="btn mt-12" bindtap="startCreate">新建录入模板</view>
      </view>
    </view>
  </view>
</view>
