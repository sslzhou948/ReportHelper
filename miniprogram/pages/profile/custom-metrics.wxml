<view class="page custom-metrics-page">
  <view class="nav custom-metrics-nav">
    <view class="nav-side left" bindtap="goBack">‹ 返回</view>
    <view class="nav-title">{{pageTitle}}</view>
    <view class="nav-side right"></view>
  </view>

  <network-banner offline="{{networkOffline}}" bind:retry="retryAfterNetwork" />
  <loading-slow-banner visible="{{loadingSlow}}" bind:retry="retrySlowLoading" bind:cancel="cancelSlowLoading" />

  <view class="pad template-tools">
    <view class="template-search-box">
      <image class="template-search-icon" src="/assets/ui-refresh/search-soft.png" mode="aspectFit" />
      <input class="search-input" value="{{keyword}}" placeholder="搜索模板名称或指标" bindinput="onSearchInput" />
    </view>
    <view class="filter-chip" bindtap="openFilter">
      <image class="filter-icon" src="/assets/ui-refresh/manual-filter.png" mode="aspectFit" />
      <text>{{filterLabel}}</text>
    </view>
  </view>

  <view wx:if="{{editing}}" class="pad mt-12">
    <view class="card edit-card">
      <view class="edit-head">
        <view class="section-marker"></view>
        <view class="edit-title">{{formTitle}}</view>
      </view>
      <view class="template-form-list">
      <view class="form-row">
        <image class="form-icon" src="/assets/ui-refresh/profile-template.png" mode="aspectFit" />
        <view class="label">检查项名称</view>
        <input class="form-input" value="{{form.metricName}}" placeholder="如 XX血药浓度、胸部CT" data-field="metricName" bindinput="onFormInput" />
      </view>
      <view class="form-row">
        <image class="form-icon" src="/assets/ui-refresh/manual-hospital.png" mode="aspectFit" />
        <view class="label">检查类型</view>
        <picker class="form-picker" range="{{categoryLabels}}" value="{{form.categoryIndex}}" bindchange="onCategoryChange">
          <view class="form-input picker-value">{{form.categoryCn}}</view>
        </picker>
        <view class="field-chevron">›</view>
      </view>
      <view wx:if="{{form.category === 'lab'}}" class="form-row">
        <image class="form-icon" src="/assets/ui-refresh/manual-result.png" mode="aspectFit" />
        <view class="label">结果类型</view>
        <picker class="form-picker" range="{{labValueTypeLabels}}" value="{{form.valueTypeIndex}}" bindchange="onValueTypeChange">
          <view class="form-input picker-value">{{form.valueTypeLabel}}</view>
        </picker>
        <view class="field-chevron">›</view>
      </view>
      <view wx:else class="form-row">
        <image class="form-icon" src="/assets/ui-refresh/manual-result.png" mode="aspectFit" />
        <view class="label">记录字段</view>
        <view class="form-input picker-value">{{form.valueTypeLabel}}</view>
      </view>
      <view wx:if="{{form.category === 'lab'}}" class="form-row">
        <image class="form-icon" src="/assets/ui-refresh/manual-unit.png" mode="aspectFit" />
        <view class="label">默认单位</view>
        <input class="form-input" value="{{form.unit}}" placeholder="如 ng/mL、mmol/L，可不填" data-field="unit" bindinput="onFormInput" />
      </view>
      <view wx:if="{{form.category === 'lab' && form.valueType === 'quantitative'}}" class="form-row">
        <image class="form-icon" src="/assets/ui-refresh/manual-reference.png" mode="aspectFit" />
        <view class="label">参考模式</view>
        <picker class="form-picker" range="{{refModeLabels}}" value="{{form.refModeIndex}}" bindchange="onRefModeChange">
          <view class="form-input picker-value">{{form.refModeLabel}}</view>
        </picker>
        <view class="field-chevron">›</view>
      </view>
      <view wx:if="{{form.category === 'lab' && form.valueType === 'quantitative' && form.refMode === 'simple_range'}}" class="form-row">
        <image class="form-icon" src="/assets/ui-refresh/manual-range.png" mode="aspectFit" />
        <view class="label">区间范围</view>
        <view class="range-inputs">
          <input class="form-input" type="digit" value="{{form.refRangeLow}}" placeholder="下限" data-field="refRangeLow" bindinput="onFormInput" />
          <view class="range-dash">-</view>
          <input class="form-input" type="digit" value="{{form.refRangeHigh}}" placeholder="上限" data-field="refRangeHigh" bindinput="onFormInput" />
        </view>
      </view>
      <view wx:elif="{{form.category === 'lab' && form.valueType === 'quantitative' && form.refMode === 'upper_bound'}}" class="form-row">
        <image class="form-icon" src="/assets/ui-refresh/manual-range.png" mode="aspectFit" />
        <view class="label">参考上限</view>
        <input class="form-input" type="digit" value="{{form.refRangeHigh}}" placeholder="如 5.6" data-field="refRangeHigh" bindinput="onFormInput" />
      </view>
      <view wx:elif="{{form.category === 'lab' && form.valueType === 'quantitative' && form.refMode === 'lower_bound'}}" class="form-row">
        <image class="form-icon" src="/assets/ui-refresh/manual-range.png" mode="aspectFit" />
        <view class="label">参考下限</view>
        <input class="form-input" type="digit" value="{{form.refRangeLow}}" placeholder="如 40" data-field="refRangeLow" bindinput="onFormInput" />
      </view>
      <view wx:elif="{{form.category === 'lab' && form.valueType === 'quantitative' && form.refMode === 'complex_text'}}" class="form-row textarea-row">
        <image class="form-icon" src="/assets/ui-refresh/manual-reference.png" mode="aspectFit" />
        <view class="label">参考范围原文</view>
        <textarea class="form-textarea" value="{{form.refText}}" placeholder="如 按年龄、孕周、周期阶段分段的参考范围" data-field="refText" bindinput="onFormInput" />
      </view>
      <view wx:elif="{{form.category === 'lab' && form.valueType === 'qualitative'}}" class="form-row">
        <image class="form-icon" src="/assets/ui-refresh/manual-reference.png" mode="aspectFit" />
        <view class="label">默认参考</view>
        <input class="form-input" value="{{form.refQualitative}}" placeholder="如 阴性" data-field="refQualitative" bindinput="onFormInput" />
      </view>
      <view wx:if="{{form.category !== 'lab'}}" class="form-row">
        <image class="form-icon" src="/assets/ui-refresh/manual-note.png" mode="aspectFit" />
        <view class="label">描述提示</view>
        <input class="form-input" value="{{form.refText}}" placeholder="如 填写影像所见或医生结论" data-field="refText" bindinput="onFormInput" />
      </view>
      </view>
      <view class="form-actions">
        <view class="btn secondary compact" bindtap="cancelEdit">取消</view>
        <view class="btn compact" bindtap="saveTemplate">
          <image class="btn-icon primary-icon" src="/assets/ui-refresh/manual-save-white.png" mode="aspectFit" />
          <text>{{saveText}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section-title">
    <view class="section-title-main">
      <view class="section-marker"></view>
      <view>{{sectionTitle}}</view>
    </view>
    <view class="section-tools">
      <view class="tiny">{{filteredItems.length}} 项</view>
      <view class="template-add-inline" bindtap="startCreate">
        <text class="add-symbol-small">+</text>
        <text>新增</text>
      </view>
    </view>
  </view>
  <view class="pad">
    <view class="card template-list-card">
      <view wx:for="{{filteredItems}}" wx:key="metricKey" class="row metric-row" data-key="{{item.metricKey}}" bindtap="openMetric">
        <image class="metric-icon" src="{{item.icon}}" mode="aspectFit" />
        <view class="flex">
          <view class="metric-name">{{item.metricName}}</view>
          <view class="metric-meta">{{item.categoryCn}}<text wx:if="{{item.unit}}"> · {{item.unit}}</text><text wx:if="{{item.refDisplay && item.refDisplay !== '--'}}"> · {{item.refDisplay}}</text><text wx:if="{{item.measureCount}}"> · 已记录 {{item.measureCount}} 次</text></view>
        </view>
        <view wx:if="{{item.source === 'custom'}}" class="pill primary">自定义</view>
        <view wx:if="{{isManageMode && item.source === 'custom'}}" class="delete-link" catchtap="deleteMetric" data-key="{{item.metricKey}}">删除</view>
        <view class="arrow">›</view>
      </view>
      <view wx:if="{{filteredItems.length === 0}}" class="empty-block">
        <view class="body strong">没有找到检查项</view>
        <view class="tiny mt-8">可以新建一个检查项，之后录入同类结果时复用单位和参考值。</view>
        <view class="btn mt-12" bindtap="startCreate">新建检查项</view>
      </view>
    </view>
  </view>
</view>
