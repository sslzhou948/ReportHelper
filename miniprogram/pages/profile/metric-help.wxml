<view class="page metric-help-page">
  <view class="nav">
    <view class="nav-side left" bindtap="goBack">‹ 返回</view>
    <view class="nav-title">指标说明</view>
    <view class="nav-side right"></view>
  </view>

  <view class="metric-help-content">
    <view class="metric-help-notice">
      <image class="notice-icon" src="/assets/ui-refresh/upload-info.png" mode="aspectFit" />
      <view class="notice-text">指标说明用于帮助理解页面信息，不构成医疗建议。</view>
    </view>

    <view class="metric-search">
      <image class="metric-search-icon" src="/assets/ui-refresh/search-soft.png" mode="aspectFit" />
      <input class="metric-search-input" value="{{keyword}}" placeholder="搜索指标说明" bindinput="onSearchInput" />
    </view>

    <view wx:if="{{filteredGroups.length}}" class="metric-help-card">
      <view wx:for="{{filteredGroups}}" wx:key="id" class="metric-help-row" data-id="{{item.id}}" bindtap="openHelp">
        <view class="metric-icon-wrap">
          <image class="metric-help-icon" src="{{item.icon}}" mode="aspectFit" />
        </view>
        <view class="metric-help-copy">
          <view class="metric-help-title">{{item.name}}</view>
          <view class="metric-help-text">{{item.text}}</view>
        </view>
        <view class="metric-help-chevron">›</view>
      </view>
    </view>
    <view wx:else class="metric-help-empty">{{emptyText}}</view>
  </view>
</view>
