<view class="page page-tab">
  <view class="nav">
    <view class="nav-side left"></view>
    <view class="nav-title">我的</view>
    <view class="nav-side right"></view>
  </view>
  <network-banner offline="{{networkOffline}}" bind:retry="retryAfterNetwork" />
  <loading-slow-banner visible="{{loadingSlow}}" bind:retry="retrySlowLoading" bind:cancel="cancelSlowLoading" />
  <view class="pad mt-12">
    <view class="card card-pad">
      <view class="profile-card-head">
        <view class="avatar-large">{{profile.avatarText}}</view>
        <view class="flex">
          <view class="title">{{profile.realName}}</view>
          <view class="sub">{{profile.summary}}</view>
          <view class="tiny">当前档案：{{profile.relation}}</view>
        </view>
        <view class="mini-btn" bindtap="goArchive">编辑</view>
      </view>
      <view class="stats">
        <view><view class="stat-num">{{reportsCount}}</view><view class="tiny">报告</view></view>
        <view><view class="stat-num">{{metricsCount}}</view><view class="tiny">指标</view></view>
        <view><view class="stat-num">{{recheckCount}}</view><view class="tiny">复查</view></view>
      </view>
    </view>
  </view>

  <view class="section-title">档案</view>
  <view class="pad">
    <view class="card">
      <view class="row" bindtap="goArchive"><view class="flex">我的档案</view><view class="tiny">当前档案：{{profile.relation}}（{{profile.realName}}）</view><view class="arrow">›</view></view>
      <view class="row" bindtap="openSwitcher"><view class="flex">档案管理</view><view class="tiny">{{profiles.length}} 份档案</view><view class="arrow">›</view></view>
    </view>
  </view>

  <view class="section-title">数据</view>
  <view class="pad">
    <view class="card">
      <view class="row" data-title="数据导出" bindtap="showStatic"><view class="flex">数据导出</view><view class="tiny">报告与指标记录</view><view class="arrow">›</view></view>
      <view class="row" data-title="报告归档管理" bindtap="showStatic"><view class="flex">报告归档管理</view><view class="tiny">{{reportsCount}} 份报告</view><view class="arrow">›</view></view>
      <view class="row" data-title="维护手动录入模板" bindtap="showStatic"><view class="flex">维护手动录入模板</view><view class="tiny">自定义项目和参考值</view><view class="arrow">›</view></view>
      <view class="row danger" data-title="清空当前档案数据" bindtap="showStatic"><view class="flex">清空当前档案数据</view><view class="arrow">›</view></view>
    </view>
  </view>

  <view class="section-title">工具</view>
  <view class="pad">
    <view class="card">
      <view class="row" data-title="使用指南" bindtap="showStatic"><view class="flex">使用指南</view><view class="arrow">›</view></view>
      <view class="row" data-title="指标说明" bindtap="showStatic"><view class="flex">指标说明</view><view class="arrow">›</view></view>
    </view>
  </view>

  <view wx:if="{{devRuntimeVisible}}" class="section-title">开发调试</view>
  <view wx:if="{{devRuntimeVisible}}" class="pad">
    <view class="card card-pad dev-card">
      <view class="dev-head">
        <view>
          <view class="dev-title">数据模式</view>
          <view class="tiny">当前：{{devApiMode}} · {{devBackendStatus}}</view>
        </view>
        <view class="dev-status {{devBackendStatus === '已连接' ? 'ok' : ''}}">{{devBackendStatus}}</view>
      </view>
      <view class="dev-segment">
        <view class="dev-option {{devApiMode === 'mock' ? 'active' : ''}}" data-mode="mock" bindtap="setDevApiMode">Mock</view>
        <view class="dev-option {{devApiMode === 'hybrid-upload' ? 'active' : ''}}" data-mode="hybrid-upload" bindtap="setDevApiMode">真实上传</view>
        <view class="dev-option {{devApiMode === 'backend' ? 'active' : ''}}" data-mode="backend" bindtap="setDevApiMode">全后端</view>
      </view>
      <view class="row compact" bindtap="chooseDevBackendBaseUrl">
        <view class="flex">后端地址</view>
        <view class="tiny dev-url">{{devBackendBaseUrl}}</view>
        <view class="arrow">›</view>
      </view>
      <view class="row compact" bindtap="connectDevBackend">
        <view class="flex">重新连接后端</view>
        <view class="tiny">{{devBackendProfileId ? '已绑定测试档案' : '未绑定测试档案'}}</view>
        <view class="arrow">›</view>
      </view>
    </view>
  </view>

  <view class="section-title">关于</view>
  <view class="pad">
    <view class="card">
      <view class="row" data-title="意见反馈" bindtap="showStatic"><view class="flex">意见反馈</view><view class="arrow">›</view></view>
      <view class="row" data-title="关于我们 v1.0.0" bindtap="showStatic"><view class="flex">关于我们</view><view class="tiny">v1.0.0</view><view class="arrow">›</view></view>
    </view>
  </view>
  <view class="pad mt-16">
    <view class="btn secondary logout" bindtap="logout">退出登录</view>
  </view>
  <profile-switcher
    visible="{{switcherVisible}}"
    profiles="{{profiles}}"
    currentProfileId="{{profile.id}}"
    bind:close="closeSwitcher"
    bind:switch="switchProfile"
    bind:add="addProfile"
    bind:edit="goArchive"
  />
</view>
