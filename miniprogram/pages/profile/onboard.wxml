<view class="page onboard-page">
  <view wx:if="{{state === 'guest'}}" class="guest-state">
    <view class="guest-visual">
      <image class="guest-visual-image" src="/assets/onboarding/login-hero-option1.jpg" mode="widthFix" />
    </view>

    <view class="guest-login-card card card-pad">
      <view class="login-card-mark">
        <image class="login-card-emblem" src="/assets/onboarding/login-card-emblem.png" mode="aspectFit" />
      </view>
      <view class="login-card-title">登录后开启智能复查档案</view>
      <view class="login-card-copy">安全保存检查报告、健康指标和复查计划</view>
      <view class="login-card-divider"></view>
      <view class="agreement-row" bindtap="toggleAgree">
        <view class="checkbox {{agreementClass}}">{{agreed ? '✓' : ''}}</view>
        <view class="agreement-copy">
          <text>我已阅读并同意</text>
          <text class="agreement-link" catchtap="openAgreement">用户协议</text>
          <text>和</text>
          <text class="agreement-link" catchtap="openPrivacy">隐私政策</text>
        </view>
      </view>
      <view class="btn mt-12 {{loggingIn ? 'disabled' : ''}}" bindtap="login">{{loggingIn ? '登录中...' : '微信登录并继续'}}</view>
    </view>
  </view>

  <view wx:elif="{{state === 'noProfile'}}" class="profile-state">
    <view class="banner onboard-banner">
      <view class="title">创建第一份病例夹</view>
      <view class="sub white mt-8">先创建一个档案，用来保存检查报告和健康指标。</view>
    </view>
    <view class="pad mt-16">
      <view class="card card-pad">
        <view class="body strong">还没有病例夹</view>
        <view class="sub mt-8">请选择这份档案是为自己还是为亲属创建，下一步补充姓名和基础信息。</view>
      </view>
      <view class="choice card card-pad mt-12" bindtap="createSelfProfile">
        <view class="choice-icon">我</view>
        <view class="flex">
          <view class="body strong">为我自己</view>
          <view class="tiny">管理自己的健康数据</view>
        </view>
        <view class="arrow">›</view>
      </view>
      <view class="choice card card-pad mt-12" bindtap="createFamilyProfile">
        <view class="choice-icon warm">亲</view>
        <view class="flex">
          <view class="body strong">为我的亲属</view>
          <view class="tiny">帮助家人管理报告与复查</view>
        </view>
        <view class="arrow">›</view>
      </view>
    </view>
    <view class="section-title">基础信息</view>
    <view class="pad">
      <view class="card">
        <view class="preview-row"><view class="sub">关系</view><view class="tiny">下一步选择</view></view>
        <view class="preview-row"><view class="sub">姓名</view><view class="tiny">必填</view></view>
        <view class="preview-row"><view class="sub">性别</view><view class="tiny">可选</view></view>
        <view class="preview-row"><view class="sub">出生日期</view><view class="tiny">可选</view></view>
      </view>
    </view>
  </view>

  <view wx:else class="checking-state">
    <view class="body strong">正在检查登录状态</view>
    <view class="tiny mt-8">请稍候</view>
  </view>
</view>
