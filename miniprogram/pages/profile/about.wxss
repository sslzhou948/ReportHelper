.center {
  text-align: center;
}

.app-mark {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto;
  border-radius: 28rpx;
  background: var(--primary-soft);
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 800;
}

.version-tap {
  display: inline-flex;
  min-height: 48rpx;
  align-items: center;
  justify-content: center;
  padding: 0 16rpx;
}
