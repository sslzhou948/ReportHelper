<view class="page archive-page">
  <view class="nav">
    <view class="nav-side left" bindtap="goBack">‹ 返回</view>
    <view class="nav-title">报告归档管理</view>
    <view class="nav-side right"></view>
  </view>

  <view class="archive-content">
    <view class="archive-notice">
      <image class="notice-icon" src="/assets/ui-refresh/upload-info.png" mode="aspectFit" />
      <view class="notice-text">按时间查看已归档报告。单份删除请进入报告详情，恢复和批量移动后续开放。</view>
    </view>

    <view class="archive-tools">
      <view class="archive-search">
        <image class="search-icon" src="/assets/ui-refresh/search-soft.png" mode="aspectFit" />
        <input class="search-input" value="{{keyword}}" placeholder="搜索报告 / 医院" bindinput="onSearchInput" />
      </view>
      <view class="archive-filter" bindtap="openFilter">
        <image class="filter-icon" src="/assets/ui-refresh/manual-filter.png" mode="aspectFit" />
        <text>{{filterLabel}}</text>
        <text class="filter-arrow">⌄</text>
      </view>
    </view>

    <block wx:if="{{loading}}">
      <view class="archive-empty">正在加载报告...</view>
    </block>
    <block wx:elif="{{reportGroups.length}}">
      <view wx:for="{{reportGroups}}" wx:key="key" wx:for-item="group" class="archive-month">
        <view class="archive-month-head">
          <view class="archive-month-title">{{group.monthTitle}}</view>
          <view class="archive-month-count">{{group.countText}}</view>
        </view>
        <view class="archive-card">
          <view wx:for="{{group.reports}}" wx:key="id" wx:for-item="report" class="archive-row" data-id="{{report.id}}" bindtap="goReport">
            <view class="date-tile">
              <view class="date-day">{{report.dateTile}}</view>
              <view class="date-week">{{report.weekday}}</view>
            </view>
            <image class="report-icon" src="/assets/ui-refresh/report-doc.png" mode="aspectFit" />
            <view class="report-main">
              <view class="report-title">{{report.title}}</view>
              <view class="report-meta">{{report.hospital}}</view>
            </view>
            <view class="status-badge {{report.statusTone}}">{{report.statusText}}</view>
            <view class="archive-arrow">›</view>
          </view>
        </view>
      </view>
    </block>
    <block wx:else>
      <view class="archive-empty">{{emptyText}}</view>
    </block>
  </view>
</view>
