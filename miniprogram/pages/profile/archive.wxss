.notice {
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 24rpx;
}

.form-card {
  padding: 0;
}

.form-row {
  min-height: 104rpx;
  padding: 22rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  border-bottom: 1rpx solid var(--border-soft);
}

.form-row:last-child {
  border-bottom: 0;
}

.label {
  width: 160rpx;
  flex: 0 0 160rpx;
}

.field-control {
  flex: 1;
  min-width: 0;
}

.field-input,
.field-value {
  width: 100%;
  min-height: 60rpx;
  color: var(--ink);
  font-size: 28rpx;
  line-height: 60rpx;
  text-align: right;
}

.field-input {
  display: block;
}

.placeholder {
  color: var(--ink-3);
}

.strong {
  font-weight: 700;
}

.btn.disabled {
  opacity: 0.58;
}
