page {
  --bg: #EDEAE4;
  --card: #FFFFFF;
  --ink: #3C3630;
  --ink-2: #7A7065;
  --ink-3: #9A9085;
  --border: #D8D4CC;
  --border-soft: #E5E1DA;
  --primary: #5A7A5A;
  --primary-soft: #E3EAE0;
  --high: #C07060;
  --high-soft: #F5E2DC;
  --low: #5A7AA8;
  --low-soft: #DDE3EE;
  --warn: #A8682E;
  --warn-soft: #FAF0E0;
  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.35;
}

view, text, input, textarea {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.page-tab {
  padding-bottom: calc(156rpx + env(safe-area-inset-bottom));
}

.nav {
  min-height: 200rpx;
  padding: 132rpx 32rpx 24rpx;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-bottom: 1rpx solid var(--border-soft);
  position: sticky;
  top: 0;
  z-index: 10;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.nav-side {
  width: 112rpx;
  min-height: 44rpx;
  color: var(--primary);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  line-height: 44rpx;
}

.nav-side.left {
  color: var(--ink);
}

.nav-side.right {
  justify-content: flex-end;
  text-align: right;
}

.banner {
  min-height: 312rpx;
  padding: 160rpx 36rpx 34rpx;
  background: linear-gradient(160deg, #6B8E6B 0%, #5A7A5A 100%);
  color: #FFFFFF;
  border-bottom-left-radius: 56rpx;
  border-bottom-right-radius: 56rpx;
}

.section-title {
  margin: 36rpx 0 20rpx;
  padding: 0 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  font-weight: 700;
}

.section-action {
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 600;
}

.pad {
  padding: 0 32rpx;
}

.pad > .card,
.bottom-action > .btn {
  width: 100% !important;
  max-width: none !important;
  margin-left: 0 !important;
  margin-right: 0 !important;
}

.card {
  background: var(--card);
  border: 1rpx solid var(--border-soft);
  border-radius: 44rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.035);
  overflow: hidden;
}

.card-pad {
  padding: 32rpx;
}

.row {
  width: 100%;
  max-width: none;
  margin-left: 0;
  margin-right: 0;
  min-height: 96rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-bottom: 1rpx solid var(--border-soft);
}

.row:last-child {
  border-bottom: 0;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
}

.body {
  font-size: 28rpx;
  color: var(--ink);
}

.sub {
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.5;
}

.tiny {
  font-size: 22rpx;
  color: var(--ink-3);
  line-height: 1.5;
}

.btn {
  height: 96rpx;
  border-radius: 32rpx;
  background: var(--primary);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  width: 100%;
  max-width: none;
  margin-left: 0;
  margin-right: 0;
}

.btn.secondary {
  background: #FFFFFF;
  color: var(--primary);
  border: 2rpx solid var(--primary);
}

.btn.danger {
  background: var(--high);
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: #F2EEE7;
  color: var(--ink-2);
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
}

.arrow {
  color: var(--ink-3);
  font-size: 34rpx;
  line-height: 1;
}

.divider-top {
  border-top: 1rpx solid var(--border-soft);
}

.notice {
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: var(--warn-soft);
  color: var(--warn);
  font-size: 24rpx;
  line-height: 1.55;
}

.empty-illustration {
  height: 280rpx;
  border-radius: 32rpx;
  border: 2rpx dashed var(--border);
  background: repeating-linear-gradient(135deg, #ECE8E1 0 12rpx, #F5F2EC 12rpx 24rpx);
  color: var(--ink-3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
}

.pill.primary {
  background: var(--primary-soft);
  color: var(--primary);
}

.pill.high {
  background: var(--high-soft);
  color: var(--high);
}

.pill.low {
  background: var(--low-soft);
  color: var(--low);
}

.pill.warn {
  background: #F7E8D8;
  color: var(--warn);
}

.value-high {
  color: var(--high);
}

.value-low {
  color: var(--low);
}

.flex {
  flex: 1;
  min-width: 0;
}

.right {
  text-align: right;
}

.mt-8 { margin-top: 16rpx; }
.mt-12 { margin-top: 24rpx; }
.mt-16 { margin-top: 32rpx; }
.mb-8 { margin-bottom: 16rpx; }

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
