.chart-scroll {
  width: 100%;
  height: 360rpx;
  border: 1rpx solid var(--border-soft);
  border-radius: 28rpx;
  background: #FFFFFF;
}

.chart {
  min-width: 860rpx;
  height: 356rpx;
  position: relative;
}

.axis-y {
  position: absolute;
  left: 72rpx;
  top: 40rpx;
  bottom: 72rpx;
  width: 1rpx;
  background: var(--border-soft);
}

.axis-x {
  position: absolute;
  left: 72rpx;
  right: 36rpx;
  bottom: 72rpx;
  height: 1rpx;
  background: var(--border-soft);
}

.tick {
  position: absolute;
  left: 0;
  right: 36rpx;
  height: 1rpx;
}

.tick-label {
  position: absolute;
  left: 0;
  top: -12rpx;
  width: 60rpx;
  color: var(--ink-3);
  font-size: 20rpx;
  line-height: 24rpx;
  text-align: right;
}

.tick-line {
  position: absolute;
  left: 72rpx;
  right: 0;
  top: 0;
  border-top: 1rpx solid var(--border-soft);
}

.ref-line {
  position: absolute;
  left: 72rpx;
  right: 36rpx;
  height: 1rpx;
  border-top: 2rpx dashed var(--primary);
  opacity: 0.82;
  z-index: 1;
}

.ref-band {
  position: absolute;
  left: 72rpx;
  right: 36rpx;
  min-height: 4rpx;
  background: var(--primary-soft);
  opacity: 0.52;
  z-index: 0;
}

.ref-label {
  position: absolute;
  right: 0;
  top: -34rpx;
  padding: 2rpx 8rpx;
  border-radius: 10rpx;
  background: #FFFFFF;
  color: var(--primary);
  font-size: 18rpx;
  line-height: 24rpx;
  white-space: nowrap;
}

.point {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  margin-left: -8rpx;
  margin-top: -8rpx;
  border-radius: 50%;
  background: var(--primary);
  border: 3rpx solid #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
  z-index: 3;
}

.point.latest {
  width: 22rpx;
  height: 22rpx;
  margin-left: -11rpx;
  margin-top: -11rpx;
}

.point.high,
.segment.high {
  background: var(--high);
}

.point.low,
.segment.low {
  background: var(--low);
}

.segment {
  position: absolute;
  height: 4rpx;
  transform-origin: left center;
  background: var(--primary);
  border-radius: 2rpx;
  z-index: 2;
}

.axis-label {
  position: absolute;
  bottom: 26rpx;
  width: 80rpx;
  margin-left: -40rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--ink-3);
}
